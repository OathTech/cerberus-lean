open import Pervasives Set_extra
import Sc_happens_before Sc_graph Sc_action_identity Core_run_aux

(* Native Pset records carry comparator closures: compare their complete
   extensional fields rather than OCaml structural equality on functions. *)
let sc_hb_graph_fields graph =
  (List.map (fun node -> let annotation = node.Sc_graph.sc_node_annotation in
     (node.Sc_graph.sc_node_id, node.Sc_graph.sc_node_thread,
      Set_extra.toOrderedList annotation.Core_run_aux.sb_before,
      Set_extra.toOrderedList annotation.Core_run_aux.asw_before,
      Set_extra.toOrderedList annotation.Core_run_aux.dd_before)) graph.Sc_graph.sc_graph_nodes,
   Set_extra.toOrderedList graph.Sc_graph.sc_graph_sb,
   Set_extra.toOrderedList graph.Sc_graph.sc_graph_asw,
   Set_extra.toOrderedList graph.Sc_graph.sc_graph_dd,
   Set_extra.toOrderedList graph.Sc_graph.sc_graph_sbasw,
   graph.Sc_graph.sc_graph_issues)

let sc_hb_checks () =
  let node id thread predecessors = <| Sc_graph.sc_node_id= id;
    Sc_graph.sc_node_thread= thread;
    Sc_graph.sc_node_annotation= <| Core_run_aux.empty_annotation with
      Core_run_aux.sb_before= Set.fromList (List.map (fun source -> (thread,source)) predecessors) |> |> in
  let graph = Sc_graph.sc_build_source_graph [node 1 0 [];node 9 0 [1];
    node 11 0 [9];node 12 0 [9];node 31 1 [];node 32 1 [];
    node 40 1 [31;32];node 41 1 [40]] in
  let alias occurrence action = <| Sc_action_identity.sc_alias_occurrence= occurrence;
    Sc_action_identity.sc_alias_action= action |> in
  let aliases = [alias 11 11;alias 12 11;alias 31 31;alias 32 31] in
  let result = Sc_happens_before.sc_build_happens_before graph aliases [(11,31)] in
  let without_sync = Sc_happens_before.sc_build_happens_before graph aliases [] in
  let missing = Sc_happens_before.sc_build_happens_before graph aliases [(11,99)] in
  let unknown = Sc_happens_before.sc_build_happens_before graph aliases [(9,40)] in
  let duplicate = Sc_happens_before.sc_build_happens_before graph (alias 11 11 :: aliases) [(11,31)] in
  let outside = Sc_happens_before.sc_build_happens_before graph (alias 66 66 :: aliases) [] in
  let cycle = Sc_happens_before.sc_build_happens_before graph aliases [(11,11)] in
  let bad = Sc_graph.sc_build_source_graph [node 1 0 [999]] in
  [
    ("all source vertices and issues retained", sc_hb_graph_fields result.Sc_happens_before.sc_hb_source = sc_hb_graph_fields graph);
    ("all aliases retained", result.Sc_happens_before.sc_hb_aliases = aliases);
    ("both RMW source and target phases expand", result.Sc_happens_before.sc_hb_sync_receipts =
      [((11,31),[(11,31);(11,32);(12,31);(12,32)])]);
    ("non-action vertices transmit synchronization", (1,41) IN result.Sc_happens_before.sc_hb_relation);
    ("source order through metadata retained", (1,12) IN result.Sc_happens_before.sc_hb_relation);
    ("empty synchronization does not order threads", not ((1,41) IN without_sync.Sc_happens_before.sc_hb_relation));
    ("no internal RMW source order invented", not ((11,12) IN result.Sc_happens_before.sc_hb_relation) &&
      not ((12,11) IN result.Sc_happens_before.sc_hb_relation));
    ("no reverse synchronization invented", not ((41,1) IN result.Sc_happens_before.sc_hb_relation));
    ("valid control has no adapter or source issues", result.Sc_happens_before.sc_hb_issues = [] &&
      graph.Sc_graph.sc_graph_issues = [] && result.Sc_happens_before.sc_hb_cycles = []);
    ("unknown reference target is explicit", missing.Sc_happens_before.sc_hb_issues =
      [Sc_happens_before.SC_hb_missing_reference_target 11 99]);
    ("missing expansion keeps its original edge", missing.Sc_happens_before.sc_hb_sync_receipts = [((11,99),[])]);
    ("raw metadata IDs are not reference actions", unknown.Sc_happens_before.sc_hb_issues =
      [Sc_happens_before.SC_hb_missing_reference_source 9 40;Sc_happens_before.SC_hb_missing_reference_target 9 40]);
    ("duplicate alias is not silently selected", List.any (fun issue -> issue =
      Sc_happens_before.SC_hb_ambiguous_occurrence 11) duplicate.Sc_happens_before.sc_hb_issues);
    ("alias missing from source graph is explicit", outside.Sc_happens_before.sc_hb_issues =
      [Sc_happens_before.SC_hb_alias_missing_vertex 66]);
    ("cycles retained as graph facts not C UB", cycle.Sc_happens_before.sc_hb_cycles = [11;12]);
    ("duplicate reference edges keep both receipts", List.length
      (Sc_happens_before.sc_build_happens_before graph aliases [(11,31);(11,31)]).Sc_happens_before.sc_hb_sync_receipts = 2);
    ("malformed source graph is preserved", sc_hb_graph_fields (Sc_happens_before.sc_build_happens_before bad [] []).Sc_happens_before.sc_hb_source = sc_hb_graph_fields bad &&
      not (List.null bad.Sc_graph.sc_graph_issues))
  ]
