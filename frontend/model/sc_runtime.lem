(* Operational SC bookkeeping. This recorder retains concrete memory effects;
   it is not, by itself, a consistency checker or a whole-program verdict. *)
open import Pervasives Core_run_aux
import Mem Mem_common Cmm_csem Sc_order

(* The request boundary and its internal observations are distinct. The journal
   order is not silently promoted to C sequenced-before or to scheduling points. *)
type sc_request_kind =
  | SC_access of Cmm_csem.memory_order * Core.polarity
  | SC_seq_rmw
  | SC_cas_expected of Cmm_csem.memory_order * Cmm_csem.memory_order * Core.polarity
  | SC_cas_object of Core.polarity
  | SC_cas_writeback of Core.polarity
  | SC_lifetime of Core.polarity
  | SC_memop of Mem_common.memop
  | SC_runtime of string
  | SC_fence of Cmm_csem.memory_order
  | SC_atomic_update of Cmm_csem.memory_order


(* Typed identities preserve all existing diagnostics. Categories describe the
   fault; they introduce neither an ISO UB verdict nor a new coverage policy. *)
type sc_fault =
  | SC_fault_unowned_memory_node
  | SC_fault_observer_unavailable
  | SC_fault_observer_lost
  | SC_fault_unowned_memory_effect
  | SC_fault_cas_no_owner
  | SC_fault_cas_outside_mode
  | SC_fault_rmw_no_owner
  | SC_fault_rmw_outside_mode
  | SC_fault_cas_read_shape
  | SC_fault_unspecified_representation
  | SC_fault_representation_size
  | SC_fault_fence_outside_mode
  | SC_fault_fence_owner
  | SC_fault_order of sc_request_kind
  | SC_fault_uninitialized
  | SC_fault_checker_pending
  | SC_fault_suspension_unavailable
  | SC_fault_resume_outside_mode
  | SC_fault_suspend_outside_mode
  | SC_fault_suspend_no_owner
  | SC_fault_suspend_wrong_thread

type sc_fault_category =
  | SC_failure_representation
  | SC_failure_observation
  | SC_failure_protocol
  | SC_failure_order
  | SC_failure_unimplemented

let sc_fault_message = function
  | SC_fault_unowned_memory_node -> "SC port gap: unowned memory node"
  | SC_fault_observer_unavailable -> "SC port gap: memory observer unavailable"
  | SC_fault_observer_lost -> "SC port gap: observer state lost"
  | SC_fault_unowned_memory_effect -> "SC port gap: unowned memory effect"
  | SC_fault_cas_no_owner -> "SC compare-exchange phase has no owner"
  | SC_fault_cas_outside_mode -> "SC compare-exchange requested outside SC mode"
  | SC_fault_rmw_no_owner -> "SC ordinary RMW phase has no owner"
  | SC_fault_rmw_outside_mode -> "SC ordinary RMW phase requested outside SC mode"
  | SC_fault_cas_read_shape -> "SC compare-exchange has no unique completed read"
  | SC_fault_unspecified_representation -> "SC representation gap: compare-exchange has unspecified bytes"
  | SC_fault_representation_size -> "SC representation gap: compare-exchange read sizes differ"
  | SC_fault_fence_outside_mode -> "SC fence requested outside SC mode"
  | SC_fault_fence_owner -> "SC fence has no matching owned request"
  | SC_fault_order _ -> "SC model excludes the requested memory order"
  | SC_fault_uninitialized -> "SC state is not initialized"
  | SC_fault_checker_pending -> "SC port gap: atomic/race/fence checker integration pending"
  | SC_fault_suspension_unavailable -> "SC port gap: memory suspension unavailable"
  | SC_fault_resume_outside_mode -> "SC service resumed without SC state"
  | SC_fault_suspend_outside_mode -> "SC service suspended without SC state"
  | SC_fault_suspend_no_owner -> "SC service suspension has no owner"
  | SC_fault_suspend_wrong_thread -> "SC service suspension changed its thread owner"
end

let sc_fault_class = function
  | SC_fault_unowned_memory_node -> SC_failure_protocol
  | SC_fault_observer_unavailable -> SC_failure_observation
  | SC_fault_observer_lost -> SC_failure_protocol
  | SC_fault_unowned_memory_effect -> SC_failure_protocol
  | SC_fault_cas_no_owner -> SC_failure_protocol
  | SC_fault_cas_outside_mode -> SC_failure_protocol
  | SC_fault_rmw_no_owner -> SC_failure_protocol
  | SC_fault_rmw_outside_mode -> SC_failure_protocol
  | SC_fault_cas_read_shape -> SC_failure_protocol
  | SC_fault_unspecified_representation -> SC_failure_representation
  | SC_fault_representation_size -> SC_failure_representation
  | SC_fault_fence_outside_mode -> SC_failure_protocol
  | SC_fault_fence_owner -> SC_failure_protocol
  | SC_fault_order _ -> SC_failure_order
  | SC_fault_uninitialized -> SC_failure_protocol
  | SC_fault_checker_pending -> SC_failure_unimplemented
  | SC_fault_suspension_unavailable -> SC_failure_observation
  | SC_fault_resume_outside_mode -> SC_failure_protocol
  | SC_fault_suspend_outside_mode -> SC_failure_protocol
  | SC_fault_suspend_no_owner -> SC_failure_protocol
  | SC_fault_suspend_wrong_thread -> SC_failure_protocol
end

type sc_request = <|
  sc_request_id: Cmm_csem.aid;
  sc_request_thread: Mem_common.thread_id;
  sc_request_annotation: core_run_annotation;
  sc_request_kind: sc_request_kind;
|>

type sc_effect = <|
  sc_effect_id: Cmm_csem.aid;
  sc_effect_request: sc_request;
  sc_effect_observation: Mem.memory_observation;
|>

type sc_completed_child = <|
  sc_child_id: Mem_common.thread_id;
  sc_child_parent: Mem_common.thread_id;
  sc_child_value: Core.value;
  sc_child_effects: Sc_order.sc_predecessors;
|>

type sc_state = <|
  sc_current_request: maybe sc_request;
  sc_current_effects: Sc_order.sc_predecessors;
  sc_effects: list sc_effect; (* newest first, preserving occurrence identity *)
  sc_completed: list sc_completed_child;
  sc_fences: list sc_request; (* completed fence occurrences, newest first *)
  sc_join_history: list (Mem_common.thread_id * Sc_order.sc_predecessors);
|>

let sc_initial_state = <|
  sc_current_request= Nothing;
  sc_current_effects= {};
  sc_effects= [];
  sc_completed= [];
  sc_fences= [];
  sc_join_history= [];
|>

let sc_begin_request request state =
  <| state with
    sc_current_request= Just <| request with sc_request_annotation=
      Sc_order.sc_thread_annotation request.sc_request_thread request.sc_request_annotation |>;
    sc_current_effects= {};
  |>

let sc_effect_polarity request observation =
  match request.sc_request_kind with
    | SC_access _ polarity -> polarity
    | SC_lifetime polarity -> polarity
    | SC_cas_expected _ _ polarity -> polarity
    | SC_cas_object polarity -> polarity
    | SC_cas_writeback polarity -> polarity
    | SC_seq_rmw ->
        match observation with
          | Mem_common.Observe_access _ Mem_common.StoreAccess _ _ _ _ _ _ _ -> Core.Neg
          | _ -> Core.Pos
        end
    | _ -> Core.Pos
  end

(* Internal memory helpers execute their existing monadic accesses in order.
   This annotation rule applies only inside that one owned request; it neither
   orders unsequenced sibling requests nor chooses interruption points. *)
let sc_internal_annotation kind predecessors annotation =
  match kind with
    | SC_memop _ -> Sc_order.sc_before_annotation (Sc_order.sc_promote predecessors) annotation
    | SC_runtime _ -> Sc_order.sc_before_annotation (Sc_order.sc_promote predecessors) annotation
    | _ -> annotation
  end

(* The driver owns the fresh supply. No independent supply or implicit fresh
   event is introduced by this function. Missing ownership is an explicit gap. *)
let sc_record_effect aid observation state =
  match state.sc_current_request with
    | Nothing -> Nothing
    | Just request ->
        let observed_request = <| request with sc_request_annotation=
          sc_internal_annotation request.sc_request_kind state.sc_current_effects
            request.sc_request_annotation |> in
        let predecessor = (sc_effect_polarity request observation,
                           (request.sc_request_thread, aid)) in
        Just <| state with
          sc_current_effects= Set.insert predecessor state.sc_current_effects;
          sc_effects= <| sc_effect_id= aid; sc_effect_request= observed_request;
                        sc_effect_observation= observation |> :: state.sc_effects;
        |>
  end

let sc_thread_effects tid state =
  let own = Set.fromList (List.map (fun recorded ->
    (Core.Pos, (tid, recorded.sc_effect_id)))
    (List.filter (fun recorded -> recorded.sc_effect_request.sc_request_thread = tid)
      state.sc_effects)) in
  let fences = Set.fromList (List.map (fun request ->
    (Core.Pos, (tid, request.sc_request_id)))
    (List.filter (fun request -> request.sc_request_thread = tid) state.sc_fences)) in
  own union fences union (match List.lookup tid state.sc_join_history with Nothing -> {} | Just effects -> effects end)

let sc_note_join tid effects state =
  let previous = match List.lookup tid state.sc_join_history with Nothing -> {} | Just prior -> prior end in
  <| state with sc_join_history= (tid, previous union effects) ::
      List.filter (fun (other, _) -> other <> tid) state.sc_join_history |>

let sc_control tid state = <|
  prior_events= sc_thread_effects tid state;
  completed_children= List.map (fun child ->
    (child.sc_child_id, (child.sc_child_value, child.sc_child_effects)))
    (List.filter (fun child -> child.sc_child_parent = tid) state.sc_completed);
|>

let sc_complete_child tid parent value state =
  <| state with sc_completed=
    <| sc_child_id= tid; sc_child_parent= parent; sc_child_value= value;
       sc_child_effects= sc_thread_effects tid state |> :: state.sc_completed |>

let sc_receipt state =
  match state.sc_current_request with
    | Nothing -> Nothing
    | Just request -> Just (request.sc_request_id, Just state.sc_current_effects)
  end

(* Comparison derivation needs the concrete abstract-byte field instance. These
   records are retained by occurrence ID, never deduplicated by their payload. *)
declare {lean} extra_import `CerbSCByteInstances`


(* Fences have source ordering and an SC position, but perform no concrete
   object-memory access. Their occurrence is the fresh request identity. *)
let sc_record_fence state =
  match state.sc_current_request with
    | Just request ->
        match request.sc_request_kind with
          | SC_fence Cmm_csem.Seq_cst ->
              Just <| state with
                sc_fences= request :: state.sc_fences;
                sc_current_effects= {(Core.Pos, (request.sc_request_thread, request.sc_request_id))};
              |>
          | _ -> Nothing
        end
    | Nothing -> Nothing
  end

(* Named SC execution does not coerce executed weaker orders. This condition
   is about the selected model, not the C program's well-typedness or UB. *)
let sc_request_in_model = function
  | SC_access order _ -> order = Cmm_csem.NA || order = Cmm_csem.Seq_cst
  | SC_fence order -> order = Cmm_csem.Seq_cst
  | SC_atomic_update order -> order = Cmm_csem.Seq_cst
  | SC_seq_rmw -> true
  | SC_cas_expected success failure _ ->
      success = Cmm_csem.Seq_cst && failure = Cmm_csem.Seq_cst
  | SC_cas_object _ -> true
  | SC_cas_writeback _ -> true
  | SC_lifetime _ -> true
  | SC_memop _ -> true
  | SC_runtime _ -> true
end


(* Read bytes come from the actual completed typed access. Re-encoding its
   value would lose padding and provenance information. No second read occurs. *)
let sc_current_read_representation state =
  match state.sc_current_request with
    | Nothing -> Nothing
    | Just request ->
        match List.concat (List.map (fun recorded ->
          if recorded.sc_effect_request.sc_request_id = request.sc_request_id then
            match recorded.sc_effect_observation with
              | Mem_common.Observe_access _ Mem_common.LoadAccess _ _ _ _ _ bytes _ -> [bytes]
              | _ -> []
            end
          else []) state.sc_effects) with
          | [bytes] -> Just bytes
          | _ -> Nothing
        end
  end
