(* TODO: A negative precision argument is taken as if the precision were omitted. *)
open import Pervasives Utils Monadic_parsing
import String_extra Errors AilTypesAux Core Core_aux Ctype Mem Mem_aux Float
import Decode Implementation Undefined

module U = Undefined

type flags = <|
  flag_minus: bool;
  flag_plus:  bool;
  flag_space: bool;
  flag_hash:  bool;
  flag_zero:  bool
|>

type field_width =
  | FW_num of nat
  | FW_asterisk

type precision =
  | P_num of nat
  | P_asterisk

(* FORK (fix/printf-refusals, 2026-11-07; contract D16): the parser accepts the full
   length-modifier and conversion-specifier syntax of C17 7.21.6.1#7-#8 — upstream c3ff8c53f
   leaves `LM_L` (:32, :133) and the e/E/g/G/a/A/F conversions (:40) commented out, so a
   conforming `printf("%e", 3.5)` was reported as `Invalid_format` undefined behaviour (a
   silently wrong verdict; upstream-tray report 68). The conversion stage REFUSES the
   unimplemented conversions loudly (`floating_refusal` below); a format the parser cannot
   parse at all stays `Invalid_format` (7.21.6.1#9, a malformed specification). *)
type length_modifier =
  | LM_hh
  | LM_h
  | LM_l
  | LM_ll
  | LM_j
  | LM_z
  | LM_t
  | LM_L

type conversion_specifier =
  | CS_di
  | CS_o
  | CS_u
  | CS_x
  | CS_X
  | CS_f
  | CS_F
  | CS_e
  | CS_E
  | CS_g
  | CS_G
  | CS_a
  | CS_A
  | CS_c
  | CS_s
  | CS_p
  | CS_n
  | CS_percent

(* the conversions of a floating argument (7.21.6.1#8 a, A, e, E, f, F, g, G) *)
val isFloatingConversion: conversion_specifier -> bool
let isFloatingConversion = function
  | CS_f -> true
  | CS_F -> true
  | CS_e -> true
  | CS_E -> true
  | CS_g -> true
  | CS_G -> true
  | CS_a -> true
  | CS_A -> true
  | _    -> false
end

(* the conversions of an integer argument (7.21.6.1#8 d, i, o, u, x, X) *)
val isIntegerConversion: conversion_specifier -> bool
let isIntegerConversion = function
  | CS_di -> true
  | CS_o  -> true
  | CS_u  -> true
  | CS_x  -> true
  | CS_X  -> true
  | _     -> false
end

val stringFromLengthModifier: maybe length_modifier -> string
let stringFromLengthModifier = function
  | Nothing    -> ""
  | Just LM_hh -> "hh"
  | Just LM_h  -> "h"
  | Just LM_l  -> "l"
  | Just LM_ll -> "ll"
  | Just LM_j  -> "j"
  | Just LM_z  -> "z"
  | Just LM_t  -> "t"
  | Just LM_L  -> "L"
end

val stringFromConversionSpecifier: conversion_specifier -> string
let stringFromConversionSpecifier = function
  | CS_di      -> "d"
  | CS_o       -> "o"
  | CS_u       -> "u"
  | CS_x       -> "x"
  | CS_X       -> "X"
  | CS_f       -> "f"
  | CS_F       -> "F"
  | CS_e       -> "e"
  | CS_E       -> "E"
  | CS_g       -> "g"
  | CS_G       -> "G"
  | CS_a       -> "a"
  | CS_A       -> "A"
  | CS_c       -> "c"
  | CS_s       -> "s"
  | CS_p       -> "p"
  | CS_n       -> "n"
  | CS_percent -> "%"
end

instance (Eq conversion_specifier)
  let (=)  = unsafe_structural_equality
  let (<>) = unsafe_structural_inequality
end

type conversion_specification = <|
  cp_flags:                flags;
  cp_field_width:          maybe field_width;
  cp_precision:            maybe precision;
  cp_length_modifier:      maybe length_modifier;
  cp_conversion_specifier: conversion_specifier
|>

type format_ =
  | F_text of list char
  | F_conv of conversion_specification
type format = list format_


val nonzero: parserM char
let nonzero =
  sat (function
    | #'1' -> true
    | #'2' -> true
    | #'3' -> true
    | #'4' -> true
    | #'5' -> true
    | #'6' -> true
    | #'7' -> true
    | #'8' -> true
    | #'9' -> true
    | _    -> false
  end)


val digit: parserM char
let digit =
  char #'0' <|> nonzero


val nonnegativeDecimalInteger: parserM nat
let nonnegativeDecimalInteger =
  nonzero    >>= fun c  ->
  many digit >>= fun cs ->
  return (foldl (fun acc n -> n + 10 * acc) 0 $ map (fun c -> String_extra.ord c - 48) (c::cs))


(* TODO: clang/gcc seems to allow 0, ie. this is not like a "C decimal integer constant" *)
val decimalInteger: parserM nat
let decimalInteger =
  many digit >>= fun cs ->
  return (foldl (fun acc n -> n + 10 * acc) 0 $ map (fun c -> String_extra.ord c - 48) cs)


val flags: parserM flags
let flags =
  many (char #'-' <|> char #'+' <|> char #' ' <|> char #'#' <|> char #'0') >>= fun xs ->
  return <|
    flag_minus= elem #'-' xs; flag_plus= elem #'+' xs;
    flag_space= elem #' ' xs; flag_hash= elem #'#' xs;
    flag_zero=  elem #'0' xs
  |>


val fieldWidth: parserM field_width
let fieldWidth =
  (char #'*' >> return FW_asterisk) <|>
  (nonnegativeDecimalInteger >>= fun n -> return $ FW_num n)


val precision: parserM precision
let output_precision =
      (char #'.' >> char #'*' >> return P_asterisk)
  <|> (char #'.' >> decimalInteger >>= fun n -> return $ P_num n)
  <|> (char #'.' >> return (P_num 0))
let inline precision = output_precision

val lengthModifier: parserM length_modifier
let lengthModifier =
      (string [#'h'; #'h'] >> return LM_hh)
  <|> (char #'h'           >> return LM_h)
  <|> (string [#'l'; #'l'] >> return LM_ll)
  <|> (char #'l'           >> return LM_l)
  <|> (char #'j'           >> return LM_j)
  <|> (char #'z'           >> return LM_z)
  <|> (char #'t'           >> return LM_t)
  <|> (char #'L'           >> return LM_L)


val conversionSpecifier: parserM conversion_specifier
let conversionSpecifier =
      (char #'d' <|> char #'i' >> return CS_di)
  <|> (char #'o' >> return CS_o)
  <|> (char #'u' >> return CS_u)
  <|> (char #'x' >> return CS_x)
  <|> (char #'X' >> return CS_X)
  <|> (char #'f' >> return CS_f)
  <|> (char #'F' >> return CS_F)
  <|> (char #'e' >> return CS_e)
  <|> (char #'E' >> return CS_E)
  <|> (char #'g' >> return CS_g)
  <|> (char #'G' >> return CS_G)
  <|> (char #'a' >> return CS_a)
  <|> (char #'A' >> return CS_A)
  <|> (char #'c' >> return CS_c)
  <|> (char #'s' >> return CS_s)
  <|> (char #'p' >> return CS_p)
  <|> (char #'n' >> return CS_n)
  <|> (char #'%' >> return CS_percent)


val conversionSpecification: parserM conversion_specification
let conversionSpecification =
  char #'%'                  >>
  flags                      >>= fun fs     ->
  optionMaybe fieldWidth     >>= fun fw_opt ->
  optionMaybe precision      >>= fun p_opt  ->
  optionMaybe lengthModifier >>= fun lm_opt ->
  conversionSpecifier        >>= fun cs     ->
  return <|
    cp_flags=                fs;
    cp_field_width=          fw_opt;
    cp_precision=            p_opt;
    cp_length_modifier=      lm_opt;
    cp_conversion_specifier= cs
  |>


val format: parserM format
let format =
  many (
        (many1 (sat (fun z -> z <> #'%')) >>= fun str -> return (F_text str))
    <|> (conversionSpecification >>= fun cs -> return (F_conv cs))
  )



(* character classes of a conversion's result, by code point (no Ord instance on char) *)
val isDigitChar: char -> bool
let isDigitChar c =
  let o = String_extra.ord c in
  48 <= o && o <= 57

val isLetterChar: char -> bool
let isLetterChar c =
  let o = String_extra.ord c in
  (97 <= o && o <= 122) || (65 <= o && o <= 90)


(* if the given flags require it, prefix the given result of the conversion with
   a sign or space or convert it to an "alternative form".
   This correspond to the flags: + space # *)
val expand: bool -> flags -> conversion_specifier -> list char -> list char
let expand is_zero fs cspec str =
  (* first doing the # flag *)
  let str =
    if fs.flag_hash then
      match cspec with
        | CS_o ->
            if isPrefixOf [#'0'] str then
              str
            else
              #'0' :: str
        | CS_x ->
            if is_zero then
              str
            else
              #'0' :: #'x' :: str
        | CS_X ->
          if is_zero then
            str
          else
            #'0' :: #'X' :: str
        | _ ->
            (* NOTE: must be a, A, e, E, f, F, g, or G *)
            (* NOTE: this is checked earlier *)
            (* FORK FIX (fix/printf-refusals, 2026-11-07; upstream-tray report 70): C17 7.21.6.1#6 `#`
               — "For a, A, e, E, f, F, g, and G conversions, the result of converting a floating-point
               number always contains a decimal-point character, even if no digits follow it"; upstream
               c3ff8c53f returned `str` unchanged under its own `TODO: not doing the right thing for
               now`, so `%#.0f` of 3.0 printed `3` (gcc `3.`). Of the floating conversions only %f is
               implemented (the others refuse below); a result without a decimal point is a
               precision-0 `[-]digits` or an infinity/NaN text, which keeps no point (7.21.6.1#8 f). *)
            if isFloatingConversion cspec && not (List.elem #'.' str)
               && List.all (fun c -> c = #'-' || isDigitChar c) str then
              str ++ [#'.']
            else
              str
      end
    else
      str in
  if isPrefixOf [#'-'] str then
    str
  else if fs.flag_plus then
      #'+' :: str
  else if fs.flag_space then
    #' ' :: str
  else
    str
(* TODO # flag *)


(* justify the result of a conversion.
   This correspond to the flag: - 0
   ASSUMES that length str < fw
   FORK FIX (fix/printf-refusals, 2026-11-07; upstream-tray report 70): the precision is the
   RESOLVED one (a `*` precision has been read by printf_aux), and the `0` flag pads AFTER the
   sign or base prefix — C17 7.21.6.1#6 `0`: "leading zeros (following any indication of sign or
   base) are used to pad to the field width rather than performing space padding, except when
   converting an infinity or NaN"; upstream c3ff8c53f put the zeros in front of the whole result,
   so `%05d` of -5 printed `000-5` (gcc `-0005`) and `%#05x` of 255 printed `00xff` (gcc
   `0x0ff`). The prefix is a leading `-`, `+` or space (`expand` above) and, after it, the `0x`/
   `0X` of a `#` hexadecimal conversion (an integer conversion's digits never contain `x`/`X`).
   An infinity or NaN (the floating result carries a letter) is space-padded. *)
val justify: maybe nat -> conversion_specifier -> flags -> nat -> list char -> list char
let justify p_opt cspec fs fw str =
  let d = fw - length str in
  (* see (§7.21.6.1#6 flag 0) *)
  let j = if isIntegerConversion cspec then
            if fs.flag_zero && not (fs.flag_minus) && isNothing p_opt then #'0' else #' '
          else if isFloatingConversion cspec then
            if fs.flag_zero && not (fs.flag_minus) && not (List.any isLetterChar str)
            then #'0' else #' '
          else
            #' ' in
  if fs.flag_minus then
    str ++ replicate d j
  else if j = #'0' then
    let (sign, rest) = match str with
      | #'-' :: rest -> ([#'-'], rest)
      | #'+' :: rest -> ([#'+'], rest)
      | #' ' :: rest -> ([#' '], rest)
      | _ -> ([], str)
    end in
    let (base, digits) = match rest with
      | #'0' :: #'x' :: digits -> ([#'0'; #'x'], digits)
      | #'0' :: #'X' :: digits -> ([#'0'; #'X'], digits)
      | _ -> ([], rest)
    end in
    sign ++ base ++ replicate d j ++ digits
  else
    replicate d j ++ str


