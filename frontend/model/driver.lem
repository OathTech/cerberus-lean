val update_core_state: Core_run.core_state -> driver_state -> driver_state
let update_core_state core_st dr_st =
  <| dr_st with core_state= core_st |>


(* POST REDUCTION SEMANTICS *)
let sc_merge_receipt previous (aid, current) =
  (aid, Just (previous union (match current with Nothing -> {} | Just effects -> effects end)))

let sc_suspend_action phase missing_owner outside_mode tid loc request =
  ND.get >>= fun state ->
  match state.sc_state with
    | Just sc ->
        match sc.Sc_runtime.sc_current_request with
          | Just current ->
              let annotation = Sc_order.sc_before_annotation
                (Sc_order.sc_promote sc.Sc_runtime.sc_current_effects)
                current.Sc_runtime.sc_request_annotation in
              let polarity = match current.Sc_runtime.sc_request_kind with
                | Sc_runtime.SC_cas_expected _ _ polarity -> polarity
                | Sc_runtime.SC_cas_object polarity -> polarity
                | Sc_runtime.SC_cas_writeback polarity -> polarity
                | _ -> Core.Pos
              end in
              let next = Core_reduction.Step_action_request2 annotation polarity
                phase loc tid false (SEU.return request) in
              ND.update (fun state -> <| state with sc_pending=
                (tid, next) :: List.filter (fun (other, _) -> other <> tid) state.sc_pending |>)
          | Nothing -> ND.kill (ND.Other (DErr_concurrency missing_owner))
        end
    | Nothing -> ND.kill (ND.Other (DErr_concurrency outside_mode))
  end

let sc_suspend_cas tid loc request =
  sc_suspend_action "SC compare-exchange phase"
    Sc_runtime.SC_fault_cas_no_owner Sc_runtime.SC_fault_cas_outside_mode
    tid loc request

let sc_suspend_seq_rmw tid loc request =
  sc_suspend_action "SC ordinary RMW write phase"
    Sc_runtime.SC_fault_rmw_no_owner Sc_runtime.SC_fault_rmw_outside_mode
    tid loc request

let sc_cas_read_representation =
  ND.get >>= fun state ->
  match state.sc_state with
    | Just sc ->
        match Sc_runtime.sc_current_read_representation sc with
          | Just bytes -> ND.return bytes
          | Nothing -> ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_cas_read_shape))
        end
    | Nothing -> ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_cas_outside_mode))
  end

let sc_cas_current_effects state =
  match state.sc_state with Nothing -> {} | Just sc -> sc.Sc_runtime.sc_current_effects end

val action_request_with:
  Loc.t -> Mem.thread_id -> (driver_state -> Core_run.completion_receipt) -> Core_reduction.action_request2 Core_run.thread_state -> driverM unit
let action_request_with loc tid receipt request =
  match request with
  | Core_reduction.AllocRequest2 pref align_ival size_ival mk_th_st' ->
      let () = Debug.print_debug_located 3 [Debug.DB_driver] loc (fun () -> "REQUEST ALLOC") in (* DEBUG *)
      driver_liftMem (Mem.allocate_region tid pref align_ival size_ival) >>= fun ptrval ->
      ND.update (fun dr_st ->
        <| dr_st with
          core_state= Core_run.update_thread_state tid (mk_th_st' (receipt dr_st) ptrval) dr_st.core_state;
          trace= ME_allocate_region tid pref align_ival size_ival ptrval :: dr_st.trace
        |>
      )
  
  | Core_reduction.CreateRequest2 pref align_ival lvalue_ty req_addr_opt init_opt mk_th_st' ->
      let () = Debug.print_debug_located 3 [Debug.DB_driver] loc (fun () -> "REQUEST CREATE") in (* DEBUG *)
      driver_liftMem (Mem.allocate_object tid pref align_ival lvalue_ty req_addr_opt init_opt) >>= fun ptrval ->
      ND.update (fun dr_st ->
        <| dr_st with
          core_state= Core_run.update_thread_state tid (mk_th_st' (receipt dr_st) ptrval) dr_st.core_state;
          trace= ME_allocate_object tid pref align_ival lvalue_ty init_opt ptrval :: dr_st.trace
        |>
      )
  
  | Core_reduction.LoadRequest2 mo lvalue_ty ptr_val mk_th_st' ->
      let () = Debug.print_debug_located 3 [Debug.DB_driver] loc (fun () -> "REQUEST LOAD") in (* DEBUG *)
      driver_liftMem (Mem.load loc lvalue_ty ptr_val) >>= fun (fp, mval) ->
      driver_liftMem (Mem.prefix_of_pointer ptr_val)  >>= fun pref       ->
      ND.update (fun dr_st ->
        <| dr_st with
          core_state= Core_run.update_thread_state tid (mk_th_st' (receipt dr_st) fp mval) dr_st.core_state;
          trace= ME_load loc pref lvalue_ty ptr_val mval :: dr_st.trace
        |>
      )
  
  | Core_reduction.StoreRequest2 mo lvalue_ty is_locking ptr_val mem_val mk_th_st' ->
      let () = Debug.print_debug_located 3 [Debug.DB_driver] loc (fun () -> "REQUEST STORE") in (* DEBUG *)
      (* TODO: need to make memory layout detect unsequenced races (use to make
         the concurency to the check even in the sequential mode) *)
      driver_liftMem (Mem.store loc lvalue_ty is_locking ptr_val mem_val) >>= fun fp ->
      driver_liftMem (Mem.prefix_of_pointer ptr_val) >>= fun pref ->
      ND.update (fun dr_st ->
        <| dr_st with
          core_state= Core_run.update_thread_state tid (mk_th_st' (receipt dr_st) fp) dr_st.core_state;
          trace= ME_store loc pref lvalue_ty is_locking ptr_val mem_val :: dr_st.trace
        |>
      )
  
  | Core_reduction.AtomicUpdateRequest2 _ lvalue_ty ptr_val update complete ->
      let atomic_ty = Ctype.Ctype [] (Ctype.Atomic (Ctype.unatomic lvalue_ty)) in
      driver_liftMem (Mem.load loc atomic_ty ptr_val) >>= fun (_, before) ->
      ND.get >>= fun current ->
      liftCore_run (update current.layout_state before) >>= fun after ->
      driver_liftMem (Mem.store loc atomic_ty false ptr_val after) >>= fun fp ->
      driver_liftMem (Mem.prefix_of_pointer ptr_val) >>= fun pref ->
      ND.update (fun dr_st ->
        <| dr_st with
          core_state= Core_run.update_thread_state tid (complete (receipt dr_st) fp before after) dr_st.core_state;
          trace= ME_seq_rmw loc pref lvalue_ty ptr_val before after :: dr_st.trace
        |>)

  | Core_reduction.SeqRMWRequest2 lvalue_ty ptr_val mk_mval' mk_th_st' ->
      driver_liftMem (Mem.load loc lvalue_ty ptr_val)              >>= fun (_, mval) ->
      liftCore_run (mk_mval' mval)                          >>= fun mval'     ->
      driver_liftMem (Mem.store loc lvalue_ty false ptr_val mval') >>= fun fp        ->
      driver_liftMem (Mem.prefix_of_pointer ptr_val)               >>= fun pref      ->
      ND.update (fun dr_st ->
        <| dr_st with
          core_state= Core_run.update_thread_state tid (mk_th_st' (receipt dr_st) fp mval mval') dr_st.core_state;
          trace= ME_seq_rmw loc pref lvalue_ty ptr_val mval mval' :: dr_st.trace
        |>
      )
  
(*
  | Core_run.RMWRequest loc sb_edges dd_edges asw_edges aid tid mo1 mo2 lvalue_ty ptr_val mval_expected mval_actual th_st' ->
      error "WIP: Driver.seq ==> RMWRequest"
  
  | Core_run.FenceRequest loc sb_edges dd_edges asw_edges aid tid mo th_st' ->
      let () = Debug.print_debug_located 3 [Debug.DB_driver] loc (fun () -> "REQUEST FENCE") in (* DEBUG *)
      ND.update (fun dr_st ->
        update_core_state (Core_run.update_thread_state tid th_st' dr_st.core_state) dr_st
      )
*)
  
  | Core_reduction.SeqRMWWriteRequest2 lvalue_ty ptr_val mval mval' previous mk_th_st' ->
      driver_liftMem (Mem.store loc lvalue_ty false ptr_val mval') >>= fun fp ->
      driver_liftMem (Mem.prefix_of_pointer ptr_val) >>= fun pref ->
      ND.update (fun dr_st -> <| dr_st with
        core_state= Core_run.update_thread_state tid
          (mk_th_st' (sc_merge_receipt previous (receipt dr_st)) fp mval mval') dr_st.core_state;
        trace= ME_seq_rmw loc pref lvalue_ty ptr_val mval mval' :: dr_st.trace |>)

  | Core_reduction.CompareExchangeRequest2 weak ty object_ptr expected desired _ _ complete ->
      driver_liftMem (Mem.load loc ty expected) >>= fun (footprint, _) ->
      sc_cas_read_representation >>= fun expected_bytes ->
      ND.get >>= fun state ->
      sc_suspend_cas tid loc (Core_reduction.CompareExchangeObjectRequest2 weak ty object_ptr
        expected desired expected_bytes (sc_cas_current_effects state) [footprint] complete)

  | Core_reduction.CompareExchangeObjectRequest2 weak ty object_ptr expected desired expected_bytes previous footprints complete ->
      (* Only this object read/conditional store is indivisible. Expected's
         ordinary read and failure write-back are separate scheduler phases. *)
      let atomic_ty = Ctype.Ctype [] (Ctype.Atomic (Ctype.unatomic ty)) in
      driver_liftMem (Mem.load loc atomic_ty object_ptr) >>= fun (read_footprint, actual) ->
      sc_cas_read_representation >>= fun object_bytes ->
      let comparison = Sc_representation.sc_compare_representation
        (List.map Mem.representation_bits object_bytes) (List.map Mem.representation_bits expected_bytes) in
      (match comparison with
        | Sc_representation.SC_same_bits ->
            if weak then ND.pick (SK_misc ["SC weak compare-exchange spurious failure"]) [true; false]
            else ND.return true
        | Sc_representation.SC_different_bits -> ND.return false
        | Sc_representation.SC_unspecified_representation ->
            ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_unspecified_representation))
        | Sc_representation.SC_representation_size_mismatch ->
            ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_representation_size))
      end) >>= fun succeeded ->
      if succeeded then
        driver_liftMem (Mem.store loc atomic_ty false object_ptr desired) >>= fun write_footprint ->
        ND.update (fun state -> <| state with core_state= Core_run.update_thread_state tid
          (complete (sc_merge_receipt previous (receipt state))
            (footprints ++ [read_footprint; write_footprint]) true) state.core_state |>)
      else
        ND.get >>= fun state ->
        sc_suspend_cas tid loc (Core_reduction.CompareExchangeWritebackRequest2 ty expected actual
          (previous union sc_cas_current_effects state) (footprints ++ [read_footprint]) complete)

  | Core_reduction.CompareExchangeWritebackRequest2 ty expected actual previous footprints complete ->
      driver_liftMem (Mem.store loc ty false expected actual) >>= fun footprint ->
      ND.update (fun state -> <| state with core_state= Core_run.update_thread_state tid
        (complete (sc_merge_receipt previous (receipt state)) (footprints ++ [footprint]) false) state.core_state |>)

  | Core_reduction.SignalFenceRequest2 _ mk_th_st' ->
      ND.get >>= fun before ->
      match before.sc_state with
        | Nothing ->
            ND.update (fun state -> <| state with core_state= Core_run.update_thread_state tid
              (mk_th_st' (receipt state)) state.core_state |>)
        | Just sc ->
            match Sc_runtime.sc_record_signal_fence sc with
              | Nothing -> ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_fence_owner))
              | Just sc' ->
                  ND.update (fun dr_st ->
                    let after = sc_note_prefix <| dr_st with sc_state= Just sc' |> in
                    <| after with core_state= Core_run.update_thread_state tid
                        (mk_th_st' (receipt after)) after.core_state |>)
            end
      end

  | Core_reduction.FenceRequest2 _ mk_th_st' ->
      ND.get >>= fun before ->
      match before.sc_state with
        | Nothing -> ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_fence_outside_mode))
        | Just sc ->
            match Sc_runtime.sc_record_fence sc with
              | Nothing -> ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_fence_owner))
              | Just sc' ->
                  ND.update (fun dr_st ->
                    let after = sc_note_prefix <| dr_st with sc_state= Just sc' |> in
                    <| after with core_state= Core_run.update_thread_state tid
                        (mk_th_st' (receipt after)) after.core_state |>)
            end
      end

  | Core_reduction.KillRequest2 is_dynamic ptr_val mk_th_st' ->
      let () = Debug.print_debug_located 3 [Debug.DB_driver] loc (fun () -> "REQUEST KILL") in (* DEBUG *)
      driver_liftMem (Mem.kill loc is_dynamic ptr_val) >>
      ND.update (fun dr_st ->
        <| dr_st with
          core_state= Core_run.update_thread_state tid (mk_th_st' (receipt dr_st)) dr_st.core_state;
          trace= ME_kill loc is_dynamic ptr_val :: dr_st.trace
        |>
      )
end


let action_request_sequential2 loc tid aid request =
  action_request_with loc tid (fun _ -> Core_run.sequential_receipt aid) request


val perform_action_request2:
  bool -> Loc.t -> Mem.thread_id -> Core_reduction.action_request2 Core_run.thread_state -> driverM unit
let perform_action_request2 with_concurrency loc tid request =
  let _execution_mode_is_random = match Global.current_execution_mode () with
    | Nothing   -> false
    | Just mode -> mode = Global.Random
  end in
  
  begin
    if with_concurrency then
      error "TODO: perform_action_request2 ==> concurrency"
    else
      liftCore_run (SEU.runS Core_run.fresh_action_id') >>= fun aid ->
      action_request_sequential2 loc tid aid request
  end

val perform_memop_with: Loc.t -> Mem_common.memop -> list Core.value -> Mem.thread_id -> (driver_state -> Core.value -> Core_run.thread_state) -> driverM unit
let perform_memop_with loc memop cvals tid complete =
  let mk_th_st value = value in
  match (memop, cvals) with
    | (Mem_common.Ptrdiff, [Core.Vctype ty; Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2)]) ->
        driver_liftMem (Mem.diff_ptrval loc ty ptr_val1 ptr_val2) >>= fun ival ->
        ND.return (mk_th_st (Core.Vobject (Core.OVinteger ival)))
    
    | (Mem_common.IntFromPtr, [Core.Vctype ref_ty; Core.Vctype (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity))); Core.Vobject (Core.OVpointer ptr_val)]) ->
        begin if ity = Ctype.Bool then
          ND.print_debug 0 [Debug.DB_driver] (fun () -> "IntFromPtr called on _Bool --> this is probably a bug in the elaboration")
        else
          ND.return ()
        end >>= fun () -> (* DEBUG *)
        driver_liftMem (Mem.intfromptr loc ref_ty ity ptr_val) >>= fun ival ->
        ND.return (mk_th_st (Core.Vobject (Core.OVinteger ival)))
    
    | (Mem_common.PtrFromInt, [Core.Vctype (Ctype.Ctype _ (Ctype.Basic (Ctype.Integer ity))); Core.Vctype ref_ty; Core.Vobject (Core.OVinteger ival)]) ->
        driver_liftMem (Mem.ptrfromint loc ity ref_ty ival) >>= fun ptrval ->
        ND.return (mk_th_st (Core.Vobject (Core.OVpointer ptrval)))
    
    | (Mem_common.PtrValidForDeref, [Core.Vctype ref_ty; Core.Vobject (Core.OVpointer ptr_val)]) ->
        driver_liftMem (Mem.validForDeref_ptrval ref_ty ptr_val) >>= fun is_valid ->
        ND.return (mk_th_st (if is_valid then Core.Vtrue else Core.Vfalse))
    
    | (Mem_common.PtrEq, [Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2)]) ->
        ND.print_debug 2 [Debug.DB_driver] (fun () -> "PtrEq") >> (* DEBUG *)
        driver_liftMem (Mem.eq_ptrval loc ptr_val1 ptr_val2) >>= fun is_eq ->
        ND.return (mk_th_st (if is_eq then Core.Vtrue else Core.Vfalse))
    
    | (Mem_common.PtrNe, [Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2)]) ->
        driver_liftMem (Mem.ne_ptrval loc ptr_val1 ptr_val2) >>= fun is_ne ->
        ND.return (mk_th_st (if is_ne then Core.Vtrue else Core.Vfalse))
    
    | (Mem_common.PtrLt, [Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2)]) ->
        driver_liftMem (Mem.lt_ptrval loc ptr_val1 ptr_val2) >>= fun is_lt ->
        ND.return (mk_th_st (if is_lt then Core.Vtrue else Core.Vfalse))
    
    | (Mem_common.PtrGt, [Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2)]) ->
        driver_liftMem (Mem.gt_ptrval loc ptr_val1 ptr_val2) >>= fun is_gt ->
        ND.return (mk_th_st (if is_gt then Core.Vtrue else Core.Vfalse))
    
    | (Mem_common.PtrLe, [Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2)]) ->
        driver_liftMem (Mem.le_ptrval loc ptr_val1 ptr_val2) >>= fun is_le ->
        ND.return (mk_th_st (if is_le then Core.Vtrue else Core.Vfalse))
    
    | (Mem_common.PtrGe, [Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2)]) ->
        driver_liftMem (Mem.ge_ptrval loc ptr_val1 ptr_val2) >>= fun is_ge ->
        ND.return (mk_th_st (if is_ge then Core.Vtrue else Core.Vfalse))
    
    | (Mem_common.Memcpy, [Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2);
                          Core.Vobject (Core.OVinteger size_ival)]) ->
        driver_liftMem (Mem.memcpy loc ptr_val1 ptr_val2 size_ival) >>= fun res ->
        ND.return (mk_th_st (Core.Vobject (Core.OVpointer res)))
    
    | (Mem_common.Memcmp, [Core.Vobject (Core.OVpointer ptr_val1); Core.Vobject (Core.OVpointer ptr_val2);
                          Core.Vobject (Core.OVinteger size_ival)]) ->
        driver_liftMem (Mem.memcmp ptr_val1 ptr_val2 size_ival) >>= fun res ->
        ND.return (mk_th_st (Core.Vobject (Core.OVinteger res)))
    
    | (Mem_common.PtrWellAligned, [Core.Vctype ref_ty; Core.Vobject (Core.OVpointer ptrval)]) ->
        driver_liftMem (Mem.isWellAligned_ptrval ref_ty ptrval) >>= fun b ->
        ND.return (mk_th_st (if b then Core.Vtrue else Core.Vfalse))
    
    | (Mem_common.Realloc, [Core.Vobject (Core.OVinteger align_ival); Core.Vobject (Core.OVpointer old_ptr);
                          Core.Vobject (Core.OVinteger size_ival)]) ->
        driver_liftMem (Mem.realloc loc tid align_ival old_ptr size_ival) >>= fun res ->
        ND.return (mk_th_st (Core.Vobject (Core.OVpointer res)))

    | (Mem_common.PtrArrayShift, [Core.Vobject (Core.OVpointer ptrval); Core.Vctype ty; Core.Vobject (Core.OVinteger n_ival)]) ->
        driver_liftMem (Mem.eff_array_shift_ptrval loc ptrval ty n_ival) >>= fun res ->
        ND.update (fun dr_st ->
          <| dr_st with
            trace= ME_eff_array_shift_ptrval ptrval ty n_ival res :: dr_st.trace
          |>
        ) >>
        ND.return (mk_th_st (Core.Vobject (Core.OVpointer res)))

    | (Mem_common.PtrMemberShift tag_sym membr_ident, [Core.Vobject (Core.OVpointer ptrval)]) ->
        driver_liftMem (Mem.eff_member_shift_ptrval loc ptrval tag_sym membr_ident) >>= fun res ->
        ND.update (fun dr_st ->
          <| dr_st with
            trace= ME_eff_member_shift_ptrval tag_sym membr_ident ptrval res :: dr_st.trace
          |>
        ) >>
        ND.return (mk_th_st (Core.Vobject (Core.OVpointer res)))

    | (Mem_common.Va_start, [Core.Vlist _ ty_cvals]) ->
        let ty_ptrs =
          List.map (function
            | Core.Vtuple [Core.Vctype ty; Core.Vobject (Core.OVpointer ptr)] -> (ty, ptr)
            | _ -> error "va_start"
          end) ty_cvals in
        driver_liftMem (Mem.va_start ty_ptrs) >>= fun res ->
        ND.return (mk_th_st (Core.Vobject (Core.OVinteger res)))

    | (Mem_common.Va_copy, [Core.Vobject (Core.OVinteger va)]) ->
        driver_liftMem (Mem.va_copy va) >>= fun res ->
        ND.return (mk_th_st (Core.Vobject (Core.OVinteger res)))

    | (Mem_common.Va_arg, [Core.Vobject (Core.OVinteger va); Core.Vctype ty]) ->
        driver_liftMem (Mem.va_arg va ty) >>= fun res ->
        ND.return (mk_th_st (Core.Vobject (Core.OVpointer res)))

    | (Mem_common.Va_end, [Core.Vobject (Core.OVinteger va)]) ->
        driver_liftMem (Mem.va_end va) >>
        ND.return (mk_th_st Core.Vunit)

    | (Mem_common.Copy_alloc_id, [Core.Vobject (Core.OVinteger ival); Core.Vobject (Core.OVpointer ptrval)]) ->
        driver_liftMem (Mem.copy_alloc_id ival ptrval) >>= fun ptrval' ->
        ND.return (mk_th_st (Core.Vobject (Core.OVpointer ptrval')))

    | (Mem_common.CHERI_intrinsic str (ret_ty, tys), cvals) ->
        let mvals =
          Utils.map2 (fun ty cval ->
            fromJust "CHERI_intrinsic call" (Caux.memValueFromValue ty cval)
          ) tys cvals in
        driver_liftMem (Mem.call_intrinsic loc str mvals) >>= fun res_opt ->
        match res_opt with
          | Just res ->
              ND.return (mk_th_st (Core.Vloaded (snd (Caux.loadedValueFromMemValue res))))
          | Nothing ->
            ND.return (mk_th_st Core.Vunit)
        end

    | _ ->
        error ("INVALID memop request: " ^ show memop ^ " ==> " ^ Pp.stringFromCore_value (Core.Vtuple cvals) )
  end >>= fun value ->
  ND.update (fun dr_st ->
    update_core_state (Core_run.update_thread_state tid (complete dr_st value) dr_st.core_state) dr_st
  )
















let perform_memop_request2 loc memop cvals tid mk_th_st =
  perform_memop_with loc memop cvals tid (fun _ value -> mk_th_st value)


let can_advance = function
  | Core_reduction.Step_ccall2 _ _ ->
      false
  | Core_reduction.Step_with_runstate2 _ _ ->
      true
  | Core_reduction.Step_tau2 _ _ _ ->
      true
  | Core_reduction.Step_action_request2 _ _ _ _ _ is_unseq_with_ccall _ ->
      (* TODO: only correct if there is only ONE thread *)
      not is_unseq_with_ccall (* false *)
  | Core_reduction.Step_join2 _ _ _ -> false
  | Core_reduction.Step_blocked2 ->
      false
  | Core_reduction.Step_error2 str ->
      error ("can_advance: Step_error2 ==> " ^ str)
  | Core_reduction.Step_thread_done2 _ _ ->
      true
  | Core_reduction.Step_done2 _ ->
      false
  | Core_reduction.Step_memop_request2 _ _ _ _ _ is_unseq_with_ccall _ ->
      (* TODO: only correct if there is only ONE thread *)
      not is_unseq_with_ccall (* false *)
  | Core_reduction.Step_spawn_threads2 _ _ ->
      true
  | Core_reduction.Step_fs2 _ _ _ _ _ ->
      false
  | Core_reduction.Step_nd2 _ ->
      true
end

type advance_info =
  | NOWAKEUP
  | WAKEUP of bool * list Mem.thread_id 

let advance_step tid step =
  match step with
    | Core_reduction.Step_ccall2 _ _ ->
        ND.return NOWAKEUP
    | Core_reduction.Step_with_runstate2 rsk step_m ->
        match rsk with
          | Core_reduction.RSK_tau _ (Core_run.TSK_Return sym mval_opt) ->
              ND.update (fun dr_st ->
                <| dr_st with trace= ME_function_return sym mval_opt :: dr_st.trace |>
              )
          | _ ->
              ND.return ()
        end >>= fun () ->
        liftCore_run step_m >>= fun th_st' ->
        ND.update (fun dr_st -> <| dr_st with
          core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
          dr_step_counter= dr_st.dr_step_counter + 1
        |>) >>= fun () ->
        ND.return NOWAKEUP

    | Core_reduction.Step_tau2 debug_str tsk th_st' ->
        match tsk with
          | Core_run.TSK_Return sym mval_opt ->
              ND.update (fun dr_st ->
                <| dr_st with trace= ME_function_return sym mval_opt :: dr_st.trace |>
              )
          | _ ->
              ND.return ()
        end >>= fun () ->          
        ND.update (fun dr_st -> <| dr_st with
          core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
          dr_step_counter= dr_st.dr_step_counter + 1
        |>) >>= fun () ->
        ND.return NOWAKEUP

    | Core_reduction.Step_action_request2 _ _ _ loc tid is_unseq_with_ccall m_request ->
        begin if is_unseq_with_ccall then
          ND.return ()
        else
          liftCore_run m_request >>= fun request ->
          perform_action_request2 false (*TODO!!! with_concurrency*) loc tid request
        end >>= fun () ->
        ND.return NOWAKEUP

    | Core_reduction.Step_join2 _ _ _ -> error "SC join reached sequential advance"
    | Core_reduction.Step_blocked2 ->
        ND.return NOWAKEUP

    | Core_reduction.Step_error2 debug_str ->
        error ("Driver.advance_step => Step_error2: " ^ debug_str)

    | Core_reduction.Step_thread_done2 parent_tid cval ->
        ND.read (fun dr_st ->
          let actions_of_current_thread: set Cmm.action =
            Set.filter (fun act ->
              Cmm.tid_of act = tid
            ) (dr_st.concurrency_state.Cmm_op.symPre.Cmm.actions) in
          Set.filter (fun act ->
            not (Set.any (fun (act', _) ->
              act = act'
            ) dr_st.concurrency_state.Cmm_op.symPre.Cmm.sb)
          ) actions_of_current_thread
        ) >>= fun (last_actions_of_current_thread: set Cmm.action) ->
        ND.update (fun dr_st -> <| dr_st with
          core_state= Core_run.kill_thread tid parent_tid (Set.map Cmm.aid_of last_actions_of_current_thread) cval dr_st.core_state;
          dr_step_counter= dr_st.dr_step_counter + 1;
        |>) >>= fun () ->
        ND.return (WAKEUP true [parent_tid])

    | Core_reduction.Step_done2 cval ->
        ND.return NOWAKEUP

    | Core_reduction.Step_memop_request2 _ loc memop cvals tid is_unseq_with_ccall mk_th_st ->
        begin if is_unseq_with_ccall then
          ND.return ()
        else
          perform_memop_request2 loc memop cvals tid (fun value -> mk_th_st (Core_run.sequential_receipt 0) value)
        end >>= fun () ->
        ND.return NOWAKEUP

    | Core_reduction.Step_spawn_threads2 mk_parent_th_st spawn_th_sts ->
        ND.read (fun dr_st ->
          State.runStateM (
            State.foldlM (fun (th_tids_, core_st_) th_st ->
              State.bind (Core_run.spawn_thread (Just tid) th_st core_st_)
                (fun (tid, core_st_') -> State.return (tid :: th_tids_, core_st_'))
            ) ([], dr_st.core_state) spawn_th_sts
          ) dr_st.core_run_state
        ) >>= fun ((spawn_tids, core_st'), run_st') ->
        ND.update (fun dr_st -> <| dr_st with
          core_run_state= run_st';
          core_state= Core_run.update_thread_state tid
                        (mk_parent_th_st spawn_tids)
                        core_st';
        |>) >>= fun () ->
        ND.return (WAKEUP false spawn_tids)

    | Core_reduction.Step_fs2 _ _ _ _ _ ->
        error "TODO: Step_fs2"
    
    | Core_reduction.Step_nd2 th_sts ->
        ND.pick (SK_misc ["nd"]) th_sts >>= fun th_st' ->
        ND.update (fun dr_st -> <| dr_st with
          core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
          dr_step_counter= dr_st.dr_step_counter + 1
        |>) >>= fun () ->
        ND.return NOWAKEUP
  end


let rec find_can_advance steps =
  match steps with
    | [] ->
        Nothing
    | step :: steps' ->
        if can_advance step then
          Just step
        else
          find_can_advance steps'
  end



let rec drive_nonmemory_steps_aux2 (acc: map Mem.thread_id (list Core_reduction.core_step2)) = function
  | [] ->
      ND.return acc
  | tid :: xs' ->
      ND.read (fun dr_st ->
        let th_info =
          match List.lookup tid dr_st.core_state.Core_run.thread_states with
            | Just z -> z
            | Nothing ->
                error ("Driver.drive_nonmemory_steps_aux2 => invalid tid: " ^ show tid)
          end in
        Core_reduction.step_ctx dr_st.layout_state dr_st.core_file dr_st.core_extern tid th_info
      ) >>= fun steps ->
      match find_can_advance steps with
        | Nothing ->
            drive_nonmemory_steps_aux2 (Map.insert tid steps acc) xs'
        | Just step ->
            advance_step tid step >>= fun wakeups ->
            let xs'' =
              match wakeups with
                | NOWAKEUP ->
                    tid :: xs'
                | WAKEUP false tids ->
                    tid :: Utils.list_inserts tids xs'
                | WAKEUP true tids ->
                    Utils.list_inserts tids xs'
              end in
            drive_nonmemory_steps_aux2 acc xs''
      end
end

(*
