(* DEBUG *)
val stringFromCore_core_state: forall 'a. Core_run.core_state -> string
declare ocaml target_rep function stringFromCore_core_state = `String_core_run.string_of_core_state`
declare lean target_rep function stringFromCore_core_state = `CerbPP.stringFromCore_core_state`


type driver_error =
  | DErr_core_run of core_run_cause
  | DErr_memory of Mem_common.mem_error
  | DErr_concurrency of Sc_runtime.sc_fault
  | DErr_filesystem of Fs.fs_fault
  | DErr_other of string

type driver_state = <|
  core_file:         Core.file Core_run.core_run_annotation;
  core_extern:       map Symbol.sym Symbol.sym; (* declarations -> definitions *)
  core_state:        Core_run.core_state;       (* state of the core program *)
  core_run_state:    Core_run.core_run_state;   (* state of the core evaluator *)
  layout_state:      Mem.mem_state;         (* state of memory layout model *)
  concurrency_state: Cmm_op.symState;       (* state of the concurrency memmodel *)
  fs_state:          Fs.fs_state;           (* committed filesystem state *)
  fs_boundary_failure: maybe (Fs.fs_state * Fs.fs_fault); (* last defined FS state on a killed branch *)
  trace:             list trace_event;
  
  sc_state: maybe Sc_runtime.sc_state;
  sc_findings: Sc_candidate.sc_retained_findings;
  sc_global_bindings: list Sc_global_bindings.sc_global_binding;
  sc_origins: maybe Sc_link_attribution.sc_link_origins;
  sc_candidate: maybe Sc_candidate.sc_candidate_classification;
  sc_pending: list (Mem_common.thread_id * Core_reduction.core_step2);
  symbolic_assoc: map Symbol.sym Core.object_value;
  
  blocked: bool; (* concurrency model ended by blocking *)
  (* DEBUG *)
  (*trace: list string;*)
  dr_step_counter: nat;
|>

let driver_state_eq dr_st1 dr_st2 =
     dr_st1.core_state = dr_st2.core_state
  && dr_st1.layout_state = dr_st2.layout_state
(*  && dr_st1.concurrency_state = dr_st2.concurrency_state *) (* TODO *)

instance (Eq driver_state)
  let (=) = driver_state_eq
  let (<>) = fun x y -> not (driver_state_eq x y)
end

(* NOTE: Used by the UI to distinguish runtime step kinds *)
type step_kind =
  | SK_action_request of string
  | SK_memop_request
  | SK_tau of string
  | SK_eval of string
  | SK_done
  | SK_misc of list string

instance (Show step_kind)
  let show kind =
    match kind with
    | SK_action_request str ->
      "action request: " ^ str
    | SK_memop_request ->
      "memop request"
    | SK_tau str ->
      "tau: " ^ str
    | SK_eval str ->
      "eval: " ^ str
    | SK_done ->
      "done"
    | SK_misc ss ->
      "misc: " ^ String.concat "," ss
    end
end

type driverM 'a = ND.ndM 'a step_kind driver_error Mem.mem_iv_constraint driver_state



(* open ND.Operators *)
let inline (>>=)      = ND.bind
let inline (>>) m1 m2 = ND.bind m1 (fun _ -> m2)


(* This channel follows the existing ND state, including every alternative and
   failure-time state. It does not replace a fault, remove a continuation or
   certify a prefix. Independent errors after discovery remain observable. *)
let sc_interpret_driver dr_st sc =
  let interpretation = Sc_candidate.sc_interpret_candidate sc in
  let issues = List.concat (List.map (fun observed ->
    List.concat (List.map (fun scope ->
      let id = observed.Sc_runtime.sc_effect_id in
      match List.find (fun event -> match event with
        | Sc_scopes.SC_scope_entered entry -> entry.Sc_scopes.sc_scope_id = scope
        | _ -> false
      end) sc.Sc_runtime.sc_scopes.Sc_scopes.sc_scope_events with
        | Just (Sc_scopes.SC_scope_entered entry) ->
            match (dr_st.sc_origins, entry.Sc_scopes.sc_scope_frame.Sc_call_context.sc_frame_definition) with
              | (Just origins, Just definition) ->
                  match Sc_link_attribution.sc_selected_definition origins definition with
                    | Just binding ->
                        match binding.Sc_link_attribution.sc_definition_selected.Sc_definition_sources.sc_selected_origin with
                          | Sc_definition_sources.SC_definition_user -> []
                          | Sc_definition_sources.SC_definition_library "Core standard library" -> []
                          | Sc_definition_sources.SC_definition_library _ -> [Sc_candidate.SC_interpret_library_protection id]
                          | _ -> [Sc_candidate.SC_interpret_runtime_origin id]
                        end
                    | _ -> [Sc_candidate.SC_interpret_runtime_origin id]
                  end
              | _ -> [Sc_candidate.SC_interpret_runtime_origin id]
            end
        | _ -> [Sc_candidate.SC_interpret_runtime_origin id]
      end) observed.Sc_runtime.sc_effect_request.Sc_runtime.sc_request_scopes)
    ) sc.Sc_runtime.sc_effects) in
  let issues = if List.null sc.Sc_runtime.sc_scopes.Sc_scopes.sc_scope_issues then issues
    else Sc_candidate.SC_interpret_scope_protocol :: issues in
  <| interpretation with Sc_candidate.sc_candidate_issues=
    interpretation.Sc_candidate.sc_candidate_issues ++ issues |>

let sc_note_prefix dr_st =
  match dr_st.sc_state with
    | Nothing -> dr_st
    | Just sc ->
        let result = Sc_candidate.sc_classify_candidate_with false (sc_interpret_driver dr_st sc) in
        <| dr_st with sc_candidate= Just result;
          sc_findings= Sc_candidate.sc_retain_findings result dr_st.sc_findings |>
  end

(* Drain after each ND memory node, including a killed node. A missing
   observer or request owner is an explicit port gap, never an empty effect. *)
let sc_post_memory dr_st =
  match dr_st.sc_state with
    | Nothing -> (Nothing, dr_st)
    | Just initial_sc ->
        if initial_sc.Sc_runtime.sc_current_request = Nothing then
          (Just (ND.Other (DErr_concurrency Sc_runtime.SC_fault_unowned_memory_node)), dr_st)
        else match Mem.take_observations dr_st.layout_state with
          | Nothing -> (Just (ND.Other (DErr_concurrency Sc_runtime.SC_fault_observer_unavailable)), dr_st)
          | Just (observations, memory) ->
              List.foldl (fun (failure, current) observation ->
                match failure with
                  | Just _ -> (failure, current)
                  | Nothing ->
                      match current.sc_state with
                        | Nothing -> (Just (ND.Other (DErr_concurrency Sc_runtime.SC_fault_observer_lost)), current)
                        | Just sc ->
                            let aid = current.core_run_state.Core_run.aid_supply in
                            match Sc_runtime.sc_record_effect aid observation sc with
                              | Nothing -> (Just (ND.Other (DErr_concurrency Sc_runtime.SC_fault_unowned_memory_effect)), current)
                              | Just sc' -> (Nothing, sc_note_prefix <| current with
                                  sc_state= Just sc';
                                  core_run_state= <| current.core_run_state with Core_run.aid_supply= aid + 1 |>;
                                |>)
                            end
                      end
                end
              ) (Nothing, <| dr_st with layout_state= memory |>) observations
        end
  end

val liftMem: forall 'a. Mem.memM 'a -> driverM 'a
let liftMem m =
  ND.liftND (fun dr_st -> dr_st.layout_state)
    (fun dr_st mem_st -> <| dr_st with layout_state= mem_st |>)
    (fun err_str -> SK_misc ["memory"; err_str])
    (fun mem_err -> DErr_memory mem_err)
    m

val driver_liftMem: forall 'a. Mem.memM 'a -> driverM 'a
let driver_liftMem m =
  ND.ND (fun dr_st ->
    let get state = state.layout_state in
    let put state memory = <| state with layout_state= memory |> in
    let info label = SK_misc ["memory"; label] in
    let err cause = DErr_memory cause in
    let ND.ND run =
      match dr_st.sc_state with
        | Nothing -> ND.liftND get put info err m
        | Just _ -> Nd_observe.lift_checked get put info err sc_post_memory m
      end in
    run dr_st)

let sc_receipt_from_state dr_st =
  match dr_st.sc_state with
    | Nothing -> error "SC completion requested in sequential state"
    | Just sc ->
        match Sc_runtime.sc_receipt sc with
          | Nothing -> error "SC completion has no active request"
          | Just receipt -> receipt
        end
  end


val get_thread_states: driverM (list (Mem.thread_id * (maybe Mem.thread_id * Core_run.thread_state)))
let get_thread_states =
  ND.get >>= fun dr_st ->
  ND.return dr_st.core_state.Core_run.thread_states


val     print_eval_conv_aux: driver_state -> Core_run.thread_state -> Core.pexpr -> Mem.memM (either Errors.error (Undefined.t Core.value))
let rec print_eval_conv_aux dr_st th_st pe =
  match Core_eval.eval_pexpr_aux2 (Loc.other "Driver.print_eval_conv_aux") Nothing dr_st.core_extern th_st.Core_run.env (Just dr_st.layout_state) dr_st.core_file pe with
  | Exception.Result (Undefined.Defined (Right cval)) ->
      ND.return (Right (Undefined.Defined cval))
  | Exception.Result (Undefined.Defined (Left (Core.Pexpr _ () (Core.PEconstrained xs)))) ->
      ND.msum "printf_eval_conv" begin
        List.map (fun (cs, pe) ->
            ( "printf_eval_conv_pe_constrained"
            , ND.addConstraints "printf_eval_conv" cs >> print_eval_conv_aux dr_st th_st pe
            )) xs
        end
  | Exception.Result (Undefined.Defined _) ->
      error "print_eval_conv: should be a value or PEconstrained"
  | Exception.Result (Undefined.Undef loc undef) ->
      ND.return (Right (Undefined.Undef loc undef))
  | Exception.Result (Undefined.Error loc err) ->
      ND.return (Right (Undefined.Error loc err))
  | Exception.Exception err ->
      ND.return (Left (Loc.other "Driver.print_eval_conv_aux", Errors.CORE_RUN err))
end

val printf_eval_conv: driver_state -> Core_run.thread_state -> Ctype.ctype -> Mem.mem_value -> Mem.memM (either Errors.error (Undefined.t Core.value))
let printf_eval_conv dr_st th_st cty mval =
  let () = Debug.print_debug 4 [] (fun () -> "printf_eval_conv") in
  let (_, cval) = Core_aux.valueFromMemValue mval in
  print_eval_conv_aux dr_st th_st $
    Translation_aux.mk_stdcall dr_st.core_file.Core.stdlib "conv_loaded_int"
    [ Caux.mk_ctype_pe cty; Core.Pexpr [] () (Core.PEval cval)]


val liftCore_run: forall 'a. Core_run.core_runM 'a -> driverM 'a
let liftCore_run m =
  ND.get >>= fun dr_st ->
  match SEU.run m dr_st.core_run_state with
    | Exception.Result (res, run_st') ->
        ND.update (fun dr_st -> <| dr_st with core_run_state= run_st' |>) >>
        match res with
          | U.Defined z ->
              ND.return z
          | U.Undef loc ubs ->
              ND.kill (ND.Undef loc ubs)
          | U.Error loc str ->
              ND.kill (ND.Error loc str)
        end
    | Exception.Exception err ->
        ND.kill (ND.Other (DErr_core_run err))
  end

(* Keep the old success callback and its commit point: buffer/errno/stat
   memory work can fail before fs_state is committed. A filesystem boundary
   instead records the last defined leaf state and kills without Core completion,
   an errno write, or a step-count increment. ND retains independent branches. *)
val driver_fs_result: forall 'a. Fs.fs_checked_result 'a ->
  ((Fs.fs_state * either Fs.fs_error 'a) -> driverM unit) -> driverM unit
let driver_fs_result (fs_st, result) complete =
  match result with
    | Left fault ->
        ND.ND (fun current ->
          (ND.NDkilled (ND.Other (DErr_filesystem fault)),
           <| current with fs_boundary_failure= Just (fs_st, fault) |>))
    | Right value -> complete (fs_st, value)
  end

val drive_fs_step_with: (driver_state -> Core_run.thread_state -> Core_run.thread_state) -> Mem.thread_id -> Core_run.thread_state -> driver_state -> Core_run.fs_oper -> driverM unit
let drive_fs_step_with complete tid th_st dr_st fs_oper =
  let th_st_from_int n =
    let (Core.Expr arena_annots _) = th_st.Core_run.arena in
    <| th_st with Core_run.arena= Core.Expr arena_annots (Core.Epure (Caux.mk_specified_pe (Caux.mk_integer_pe n))) |>
  in
  let th_st_from_ptr p =
    let (Core.Expr arena_annots _) = th_st.Core_run.arena in
    <| th_st with Core_run.arena= Core.Expr arena_annots (Core.Epure (Caux.mk_specified_pe (Caux.mk_value_pe (Core.Vobject (Core.OVpointer p))))) |>
  in
  let th_st_from_void () =
    let (Core.Expr arena_annots _) = th_st.Core_run.arena in
    <| th_st with Core_run.arena= Core.Expr arena_annots (Core.Epure (Caux.mk_value_pe Core.Vunit)) |>
  in
  let update fs_st th_st =
    ND.update $ fun dr_st ->
      let core_st' = Core_run.update_thread_state tid (complete dr_st th_st) dr_st.core_state in
      <| dr_st with
        fs_state= fs_st;
        core_state= core_st';
        dr_step_counter= dr_st.dr_step_counter + 1;
      |>
  in
  let store_error e =
    let errname = Fs.fs_string_of_error e in
    let err = Builtins.translate_errno ("__cerbvar_" ^ errname) in
    let err_mval = Mem.integer_value_mval (Ctype.Signed Ctype.Int_) (Mem.integer_ival err) in
    driver_liftMem $ Mem.store (Loc.other "update errno") Ctype.signed_int false th_st.Core_run.errno err_mval
  in
  let return (fs_st, res) =
    match res with
      | Left e ->
        store_error e >>
        update fs_st (th_st_from_int (0 - 1))
      | Right n ->
        update fs_st $ th_st_from_int (integerFromNat n)
    end
  in
  let store_buffer ptr (fs_st, res) =
    match res with
      | Left e ->
        store_error e >>
        update fs_st (th_st_from_int (0 - 1))
      | Right buf ->
        let n = integerFromNat $ List.length buf in
        (* TODO: store chars is wrong here!! it adds a \0 in the end of the array *)
        driver_liftMem (Formatted.store_chars_in_array false ptr buf) >>
        update fs_st (th_st_from_int n)
    end
  in
  let store_buffer_trunc ptr max (fs_st, res) =
    match res with
      | Left e ->
        store_error e >>
        update fs_st (th_st_from_int (0 - 1))
      | Right buf ->
        let buf_trunc = List.take (natFromInteger max) buf in
        let n = integerFromNat $ List.length buf_trunc in
        driver_liftMem (Formatted.store_chars_in_array false ptr buf_trunc) >>
        update fs_st (th_st_from_int n)
    end
  in
  let update_stdout out_chars =
    ND.update (fun dr_st ->
      let core_st' = Core_run.update_thread_state tid (complete dr_st (th_st_from_int (integerFromNat (List.length out_chars)))) dr_st.core_state in
      <| dr_st with
        core_state= <| core_st' with
          Core_run.io= <| dr_st.core_state.Core_run.io with Core_run.stdout=
                Dlist.append (Dlist.singleton (String.toString out_chars)) dr_st.core_state.Core_run.io.Core_run.stdout
              |>
        |>;
        dr_step_counter= dr_st.dr_step_counter + 1;
      |>
    )
  in
  let update_stderr out_chars =
    ND.update (fun dr_st ->
      let core_st' = Core_run.update_thread_state tid (complete dr_st (th_st_from_int (integerFromNat (List.length out_chars)))) dr_st.core_state in
      <| dr_st with
        core_state= <| core_st' with
          Core_run.io= <| dr_st.core_state.Core_run.io with Core_run.stderr=
                Dlist.append (Dlist.singleton (String.toString out_chars)) dr_st.core_state.Core_run.io.Core_run.stderr
              |>
        |>;
        dr_step_counter= dr_st.dr_step_counter + 1;
      |>
    )
  in
  let struct_sym name =
    let dom = Map.domain dr_st.core_file.Core.tagDefs in
    let res = Set.filter (fun sym ->
      match sym with
      | Symbol.Symbol _ _ (Symbol.SD_Id n) -> n = name
      | _ -> error ("symbol struct " ^ name ^ " not in tagDefs")
      end) dom
    in
    match Set_extra.toList res with
    | [] -> error ("no symbols for struct " ^ name ^ " in tagDefs")
    | [sym] -> sym
    | sym::_ -> sym
    end
  in
  let store_dir (fs_st, res) =
    let sym = struct_sym "dirent" in
    let loc = Loc.other "store struct dirent" in
    let dirent_cty = Ctype.Ctype [] (Ctype.Struct sym) in
    let update_mem dir_name =
      Mem.bind (Mem.allocate_object tid (Symbol.PrefOther "dirent") (Mem.alignof_ival dirent_cty) dirent_cty Nothing Nothing) (fun dirent_ptr ->
        let d_name_ptr = Mem.member_shift_ptrval dirent_ptr sym (Symbol.Identifier loc "d_name") in
        Mem.bind (Formatted.store_chars_in_array true d_name_ptr dir_name) (fun _ ->
          (Mem.return dirent_ptr)))
    in
    match res with
    | Left e ->
      store_error e >>
      update fs_st (th_st_from_ptr (Mem.null_ptrval dirent_cty))
    | Right [] ->
      update fs_st (th_st_from_ptr (Mem.null_ptrval dirent_cty))
    | Right dir_name ->
      driver_liftMem (update_mem dir_name) >>= fun dirent_ptr ->
      update fs_st (th_st_from_ptr dirent_ptr)
    end
  in
  let store_stat stat_ptr (fs_st, res) =
    let sym = struct_sym "stat" in
    let update_mem stat =
      let loc = Loc.other "store struct stat" in
      let store iTy memb f =
        let ptr = Mem.member_shift_ptrval stat_ptr sym (Symbol.Identifier loc memb) in
        let mval = Mem.integer_value_mval iTy (Mem.integer_ival (f stat)) in
        Mem.store loc (Ctype.Ctype [] (Ctype.Basic (Ctype.Integer iTy))) false
                  ptr mval
      in
      let sint = Ctype.Unsigned Ctype.Int_ in
      let uint = Ctype.Signed Ctype.Int_ in
      let ushort = Ctype.Unsigned Ctype.Short in
      let slonglong = Ctype.Signed Ctype.LongLong in
      let ulonglong = Ctype.Unsigned Ctype.LongLong in
      Mem.bind (store sint "st_dev" Fs.fs_dev) (fun _ ->
      Mem.bind (store ulonglong "st_ino" Fs.fs_ino) (fun _ ->
      Mem.bind (store ushort "st_mode" Fs.fs_mode) (fun _ ->
      Mem.bind (store ushort "st_nlink" Fs.fs_nlink) (fun _ ->
      Mem.bind (store uint "st_uid" Fs.fs_uid) (fun _ ->
      Mem.bind (store uint "st_gid" Fs.fs_gid) (fun _ ->
      Mem.bind (store sint "st_rdev" Fs.fs_rdev) (fun _ ->
               (store slonglong "st_size" Fs.fs_size) )))))))
    in
    match res with
    | Left e ->
      store_error e >>
      update fs_st (th_st_from_int (0 - 1))
    | Right stat ->
      driver_liftMem (update_mem stat) >>
      update fs_st (th_st_from_int 0)
    end
  in
  match fs_oper with
    | Core_run.FS_MKDIR path mode ->
      driver_fs_result (Fs.fs_mkdir_checked dr_st.fs_state path mode) (return)
    | Core_run.FS_OPEN path oflag mode_opt ->
      driver_fs_result (Fs.fs_open_checked dr_st.fs_state path oflag mode_opt) (return)
    | Core_run.FS_CLOSE fd ->
      driver_fs_result (Fs.fs_close_checked dr_st.fs_state fd) (return)
    | Core_run.FS_WRITE fd buf size ->
      match natFromInteger fd with
      | 0 ->
        error "driver_fs_step: stdin not supported yet."
      | 1 ->
        update_stdout (List.take (natFromInteger size) buf)
      | 2 ->
        update_stderr (List.take (natFromInteger size) buf)
      | _ ->
        driver_fs_result (Fs.fs_write_checked dr_st.fs_state fd buf size) (return)
      end
    | Core_run.FS_READ fd ptr size ->
      driver_fs_result (Fs.fs_read_checked dr_st.fs_state fd size) (store_buffer ptr)
    | Core_run.FS_PWRITE fd buf size off ->
      driver_fs_result (Fs.fs_pwrite_checked dr_st.fs_state fd buf size off) (return)
    | Core_run.FS_PREAD fd ptr size off ->
      driver_fs_result (Fs.fs_pread_checked dr_st.fs_state fd size off) (store_buffer ptr)
    | Core_run.FS_UMASK mode ->
      driver_fs_result (Fs.fs_umask_checked dr_st.fs_state mode) (return)
    | Core_run.FS_CHMOD path mode ->
      driver_fs_result (Fs.fs_chmod_checked dr_st.fs_state path mode) (return)
    | Core_run.FS_CHDIR path ->
      driver_fs_result (Fs.fs_chdir_checked dr_st.fs_state path) (return)
    | Core_run.FS_CHOWN path uid gid ->
      driver_fs_result (Fs.fs_chown_checked dr_st.fs_state path uid gid) (return)
    | Core_run.FS_LINK oldpath newpath ->
      driver_fs_result (Fs.fs_link_checked dr_st.fs_state oldpath newpath) (return)
    | Core_run.FS_READLINK path ptr max ->
      driver_fs_result (Fs.fs_readlink_checked dr_st.fs_state path) (store_buffer_trunc ptr max)
    | Core_run.FS_STAT path ptr ->
      driver_fs_result (Fs.fs_stat_checked dr_st.fs_state path) (store_stat ptr)
    | Core_run.FS_LSTAT path ptr ->
      driver_fs_result (Fs.fs_lstat_checked dr_st.fs_state path) (store_stat ptr)
    | Core_run.FS_SYMLINK target lpath ->
      driver_fs_result (Fs.fs_symlink_checked dr_st.fs_state target lpath) (return)
    | Core_run.FS_RMDIR path ->
      driver_fs_result (Fs.fs_rmdir_checked dr_st.fs_state path) (return)
    | Core_run.FS_TRUNCATE path len ->
      driver_fs_result (Fs.fs_truncate_checked dr_st.fs_state path len) (return)
    | Core_run.FS_UNLINK path ->
      driver_fs_result (Fs.fs_unlink_checked dr_st.fs_state path) (return)
    | Core_run.FS_LSEEK fd off whence ->
      driver_fs_result (Fs.fs_lseek_checked dr_st.fs_state fd off whence) (return)
    | Core_run.FS_RENAME oldpath newpath ->
      driver_fs_result (Fs.fs_rename_checked dr_st.fs_state oldpath newpath) (return)
    | Core_run.FS_OPENDIR path ->
      driver_fs_result (Fs.fs_opendir_checked dr_st.fs_state path) (return)
    | Core_run.FS_READDIR dir ->
      driver_fs_result (Fs.fs_readdir_checked dr_st.fs_state dir) (store_dir)
    | Core_run.FS_REWINDDIR dir ->
      driver_fs_result (Fs.fs_rewinddir_checked dr_st.fs_state dir)
        (fun (fs_st, _) -> update fs_st (th_st_from_void ()))
    | Core_run.FS_CLOSEDIR dir ->
      driver_fs_result (Fs.fs_closedir_checked dr_st.fs_state dir) (return)
    | Core_run.FS_PRINTF fmt args ->
      driver_liftMem (Formatted.printf th_st.Core_run.current_loc (printf_eval_conv dr_st th_st) fmt args) >>= function
        | Left err ->
          error "TODO: printf error"
        | Right (Undefined.Defined buf) ->
          update_stdout buf
        | Right (Undefined.Error loc str) ->
          ND.kill (ND.Error loc str)
        | Right (Undefined.Undef loc ubs) ->
          ND.kill (ND.Undef loc ubs)
      end
    | Core_run.FS_VPRINTF fd fmt ap ->
      driver_liftMem (Formatted.vprintf th_st.Core_run.current_loc (printf_eval_conv dr_st th_st) fmt ap) >>= function
        | Left err ->
          error "TODO: vprintf error"
        | Right (Undefined.Defined buf) ->
          let size = integerFromNat $ List.length buf in
          match natFromInteger fd with
          | 0 ->
            error "vprintf trying to output in the stdin"
          | 1 ->
            update_stdout buf
          | 2 ->
            update_stderr buf
          | _ ->
            driver_fs_result (Fs.fs_write_checked dr_st.fs_state fd buf size) (return)
          end
        | Right (Undefined.Error loc str) ->
          ND.kill (ND.Error loc str)
        | Right (Undefined.Undef loc ubs) ->
          ND.kill (ND.Undef loc ubs)
      end
    | Core_run.FS_VSNPRINTF ptr size fmt ap ->
      driver_liftMem (Formatted.vsnprintf th_st.Core_run.current_loc (printf_eval_conv dr_st th_st) ptr size fmt ap) >>= function
        | Left err ->
          error "TODO: vprintf error"
        | Right (Undefined.Defined n) ->
          update dr_st.fs_state $ th_st_from_int n
        | Right (Undefined.Error loc str) ->
          ND.kill (ND.Error loc str)
        | Right (Undefined.Undef loc ubs) ->
          ND.kill (ND.Undef loc ubs)
      end
  end


let drive_fs_step tid th_st dr_st fs_oper =
  drive_fs_step_with (fun _ result -> result) tid th_st dr_st fs_oper




