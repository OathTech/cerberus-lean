val new_drive_core_threads: unit -> driverM (list (Mem.thread_id * maybe Core_reduction.core_step2))
let new_drive_core_threads () =
  ND.get >>= fun dr_st ->
  let tids = List.map fst dr_st.core_state.Core_run.thread_states in
  drive_nonmemory_steps_aux2 Map.empty (*NEXT*) tids >>= fun m ->
  ND.mapM (fun (tid, steps) ->
    let size = List.length steps in
    let () = 
      if size > 1 then
        Debug.print_debug 5 [] (fun () ->
          "picking step for thread(" ^ show tid ^ ") size: " ^ show size ^ " ==> " ^ show steps
        )
      else
        () in
    ND.pick (SK_misc ["new_drive_core_threads"]) steps >>= fun step ->
    let () =
    if size > 1 then
      Debug.print_debug 5 [] (fun () ->
        "===> PICKED: " ^ show step
      )
    else
      () in
    ND.return (tid, Just step)
  ) (Map_extra.toList m)











let prepare_exit core_st cval =
  match List.find (function (_, (Nothing, _)) -> true | _ -> false end) core_st.Core_run.thread_states with
    | Nothing ->
        error "Driver.prepare_exit ==> failed to find the initial thread"
    | Just (tid0, (_, th_st)) ->
        let th_st' =
          <| th_st with Core_run.arena= Core_aux.mk_value_e cval; Core_run.stack= Core_run.Stack_empty |> in
        <| core_st with Core_run.thread_states= [(tid0, (Nothing, th_st'))] |>
  end

(* performing all action and memop requests until there are no more *)
val process_core_step2: bool -> (bool -> driverM unit) -> Core_reduction.core_step2 -> driverM unit
let process_core_step2 with_concurrency driver2 = function
  | Core_reduction.Step_action_request2 _ _ _ loc tid _ m_request ->
      liftCore_run m_request >>= fun request ->
      perform_action_request2 with_concurrency loc tid request >>= fun () ->
      driver2 with_concurrency

  | Core_reduction.Step_memop_request2 _ loc memop cvals tid _ mk_th_st ->
      perform_memop_request2 loc memop cvals tid (fun value -> mk_th_st (Core_run.sequential_receipt 0) value) >>= fun () ->
      driver2 with_concurrency
  
  | Core_reduction.Step_done2 cval ->
    ND.print_debug 3 [Debug.DB_driver] (fun () ->
      "driver.process_core_step ==> Step_done2 with value: " ^ Pp.stringFromCore_value cval
    ) >> (* DEBUG *)
    (* ND.return () *)
    ND.update (fun dr_st ->
      (* killing all threads and aborting the main thread and placing [cval] as its result *)
      <| dr_st with core_state= prepare_exit dr_st.core_state cval |>
    )
  

  | Core_reduction.Step_ccall2 tid step_m ->
      liftCore_run step_m >>= fun th_st' ->
      ND.update (fun dr_st -> <| dr_st with
        core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
        dr_step_counter= dr_st.dr_step_counter + 1
      |>) >>= fun () ->
        driver2 with_concurrency
  
  | Core_reduction.Step_fs2 _ tid th_st _ m_fs_step ->
      liftCore_run m_fs_step >>= function
        | Core_reduction.FS_done cval ->
            ND.update (fun dr_st ->
              (* killing all threads and aborting the main thread and placing [cval] as its result *)
              <| dr_st with core_state= prepare_exit dr_st.core_state cval |>
            )
        | Core_reduction.FS_oper fs_step ->
            ND.get                                >>= fun dr_st ->
            drive_fs_step tid th_st dr_st fs_step >>= fun ()    ->
            driver2 with_concurrency
      end

  | wrong_step ->
      error ("Driver.process_core_step2: WRONG STEP ==> " ^ show wrong_step)
end


let sc_request_state tid kind annotation dr_st =
  match dr_st.sc_state with
    | Nothing -> dr_st
    | Just sc ->
        let aid = dr_st.core_run_state.Core_run.aid_supply in
        <| dr_st with
          sc_state= Just (Sc_runtime.sc_begin_request
            <| Sc_runtime.sc_request_id= aid; Sc_runtime.sc_request_thread= tid;
               Sc_runtime.sc_request_annotation= annotation; Sc_runtime.sc_request_kind= kind;
               Sc_runtime.sc_request_scopes= Sc_scopes.sc_scope_thread tid sc.Sc_runtime.sc_scopes |> sc);
          core_run_state= <| dr_st.core_run_state with Core_run.aid_supply= aid + 1 |>;
        |>
  end

let sc_begin_request tid kind annotation =
  ND.update (sc_request_state tid kind annotation)

let sc_initial_annotation tid dr_st =
  match dr_st.sc_state with
    | Nothing -> Core_run.empty_annotation
    | Just sc -> Sc_order.sc_before_annotation (Sc_runtime.sc_thread_effects tid sc)
        Core_run.empty_annotation
  end

let sc_enable = ND.ND (fun dr_st ->
  match Mem.begin_observing dr_st.layout_state with
    | Nothing -> (ND.NDkilled (ND.Other (DErr_concurrency Sc_runtime.SC_fault_observer_unavailable)), dr_st)
    | Just memory -> (ND.NDactive (), <| dr_st with layout_state= memory;
        sc_state= Just Sc_runtime.sc_initial_state; sc_pending= []; sc_findings= Sc_candidate.sc_no_findings; sc_global_bindings= []; sc_candidate= Nothing |>)
  end)

let sc_kind_of_request polarity = function
  | Core_reduction.LoadRequest2 order _ _ _ -> Sc_runtime.SC_access order polarity
  | Core_reduction.StoreRequest2 order _ _ _ _ _ -> Sc_runtime.SC_access order polarity
  | Core_reduction.AtomicUpdateRequest2 order _ _ _ _ -> Sc_runtime.SC_atomic_update order
  | Core_reduction.SeqRMWRequest2 _ _ _ _ -> Sc_runtime.SC_seq_rmw
  | Core_reduction.SeqRMWWriteRequest2 _ _ _ _ _ _ -> Sc_runtime.SC_seq_rmw
  | Core_reduction.CompareExchangeRequest2 _ _ _ _ _ success failure _ ->
      Sc_runtime.SC_cas_expected success failure polarity
  | Core_reduction.CompareExchangeObjectRequest2 _ _ _ _ _ _ _ _ _ -> Sc_runtime.SC_cas_object polarity
  | Core_reduction.CompareExchangeWritebackRequest2 _ _ _ _ _ _ -> Sc_runtime.SC_cas_writeback polarity
  | Core_reduction.SignalFenceRequest2 order _ -> Sc_runtime.SC_signal_fence order
  | Core_reduction.FenceRequest2 order _ -> Sc_runtime.SC_fence order
  | _ -> Sc_runtime.SC_lifetime polarity
end

type sc_step_progress = SC_continue | SC_halted | SC_blocked

(* Saved computations use the existing driver state, not the enclosing machine
   state. This keeps the complete configuration free of negative recursion. *)
type sc_saved_service = <|
  sc_saved_request: Sc_runtime.sc_request;
  sc_saved_effects: Sc_order.sc_predecessors;
  sc_saved_computation: driverM sc_step_progress;
|>

type sc_services = <|
  sc_suspended_services: list sc_saved_service;
  sc_filesystem_owner: maybe Mem.thread_id;
|>

type sc_machine_state = <|
  sc_driver_state: driver_state;
  sc_service_state: sc_services;
|>

type sc_machineM 'a = ND.ndM 'a step_kind driver_error Mem.mem_iv_constraint sc_machine_state

type sc_service_choice =
  | SC_start_service of Mem.thread_id * Core_reduction.core_step2
  | SC_resume_service of sc_saved_service

let sc_empty_services = <| sc_suspended_services= []; sc_filesystem_owner= Nothing |>

let sc_machine_initial state = <| sc_driver_state= state; sc_service_state= sc_empty_services |>


(* Observe each actual call/return transition before installing the new Core
   thread. Scope ids are per alternative and never consume action ids. *)
let sc_observe_thread tid after dr_st =
  match dr_st.sc_state with
    | Nothing -> dr_st
    | Just sc ->
        let scopes = match List.lookup tid dr_st.core_state.Core_run.thread_states with
          | Nothing -> Sc_scopes.sc_scope_note (Sc_scopes.SC_scope_missing_thread tid) sc.Sc_runtime.sc_scopes
          | Just (_, before) -> Sc_scopes.sc_scope_observe dr_st.core_file dr_st.core_extern
              tid dr_st.core_run_state.Core_run.aid_supply before after sc.Sc_runtime.sc_scopes
        end in
        <| dr_st with sc_state= Just <| sc with Sc_runtime.sc_scopes= scopes |> |>
  end

(* prepare_exit is also used between global initializers. Discarded frames
   are not normal returns or evidence that the outer C execution ended. *)
let sc_discard_scopes dr_st =
  match dr_st.sc_state with
    | Nothing -> dr_st
    | Just sc ->
        let scopes = List.foldl (fun scopes (tid, _) ->
          Sc_scopes.sc_scope_discard tid dr_st.core_run_state.Core_run.aid_supply scopes)
          sc.Sc_runtime.sc_scopes dr_st.core_state.Core_run.thread_states in
        <| dr_st with sc_state= Just <| sc with Sc_runtime.sc_scopes= scopes |> |>
  end

let sc_service_step tid step =
  ND.update (fun state -> <| state with sc_pending=
    List.filter (fun (other, _) -> other <> tid) state.sc_pending |>) >>
  let resume th_st =
    ND.update (fun dr_st ->
      let dr_st = sc_observe_thread tid th_st dr_st in <| dr_st with
      core_state= Core_run.update_thread_state tid th_st dr_st.core_state;
      dr_step_counter= dr_st.dr_step_counter + 1;
    |>) >> ND.return SC_continue in
  match step with
    | Core_reduction.Step_action_request2 annotation polarity _ loc _ _ request_m ->
        liftCore_run request_m >>= fun request ->
        let kind = sc_kind_of_request polarity request in
        if Sc_runtime.sc_request_in_model kind then
          sc_begin_request tid kind annotation >>
          (match request with
            | Core_reduction.SeqRMWRequest2 ty ptr mk_value complete ->
                driver_liftMem (Mem.load loc ty ptr) >>= fun (_, before_value) ->
                liftCore_run (mk_value before_value) >>= fun after_value ->
                ND.get >>= fun before ->
                sc_suspend_seq_rmw tid loc (Core_reduction.SeqRMWWriteRequest2
                  ty ptr before_value after_value (sc_cas_current_effects before) complete)
            | _ -> action_request_with loc tid sc_receipt_from_state request
          end) >> ND.return SC_continue
        else ND.kill (ND.Other (DErr_concurrency (Sc_runtime.SC_fault_order kind)))
    | Core_reduction.Step_memop_request2 annotation loc memop values _ _ resume_request ->
        sc_begin_request tid (Sc_runtime.SC_memop memop) annotation >>
        perform_memop_with loc memop values tid
          (fun dr_st value -> resume_request (sc_receipt_from_state dr_st) value) >> ND.return SC_continue
    | Core_reduction.Step_ccall2 _ call_m ->
        liftCore_run call_m >>= resume
    | Core_reduction.Step_with_runstate2 kind step_m ->
        match kind with
          | Core_reduction.RSK_tau _ (Core_run.TSK_Return sym value) ->
              ND.update (fun dr_st -> <| dr_st with trace= ME_function_return sym value :: dr_st.trace |>)
          | _ -> ND.return ()
        end >> liftCore_run step_m >>= resume
    | Core_reduction.Step_tau2 _ kind th_st ->
        match kind with
          | Core_run.TSK_Return sym value ->
              ND.update (fun dr_st -> <| dr_st with trace= ME_function_return sym value :: dr_st.trace |>)
          | _ -> ND.return ()
        end >> resume th_st
    | Core_reduction.Step_nd2 states ->
        ND.pick (SK_misc ["SC Core choice"]) states >>= resume
    | Core_reduction.Step_spawn_threads2 make_parent children ->
        ND.get >>= fun before ->
        let ((tids, core_st), run_st) = State.runStateM
          (State.foldlM (fun (tids, core_st) child ->
             State.bind (Core_run.spawn_thread (Just tid) child core_st)
               (fun (child_tid, core_st') -> State.return (child_tid :: tids, core_st'))
           ) ([], before.core_state) children) before.core_run_state in
        ND.update (fun dr_st -> <| dr_st with core_state= core_st; core_run_state= run_st |>) >>
        (* Child errno is a distinct object. C11 7.5p3 gives it an indeterminate
           initial value; retain upstream's explicit no-zero-store requirement. *)
        ND.mapM_ (fun child_tid ->
          sc_begin_request child_tid (Sc_runtime.SC_runtime "child errno allocation") Core_run.empty_annotation >>
          driver_liftMem (Mem.allocate_object child_tid (Symbol.PrefOther "errno")
            (Mem.alignof_ival Ctype.signed_int) Ctype.signed_int Nothing Nothing) >>= fun pointer ->
          ND.update (fun dr_st ->
            match List.lookup child_tid dr_st.core_state.Core_run.thread_states with
              | Nothing -> dr_st
              | Just (_, child) ->
                  let child' = <| child with Core_run.errno= pointer;
                    Core_run.arena= Sc_order.sc_inherit_expr
                      (sc_initial_annotation child_tid dr_st) child.Core_run.arena |> in
                  <| dr_st with core_state= Core_run.update_thread_state child_tid child' dr_st.core_state |>
            end)
        ) (List.reverse tids) >>
        (* Preserve child order: the fold's accumulator is newest first. *)
        resume (make_parent (List.reverse tids))
    | Core_reduction.Step_thread_done2 parent value ->
        ND.update (fun dr_st ->
          match dr_st.sc_state with
            | Nothing -> dr_st
            | Just sc -> <| dr_st with
                core_state= <| dr_st.core_state with Core_run.thread_states=
                  List.filter (fun (other, _) -> other <> tid) dr_st.core_state.Core_run.thread_states |>;
                sc_state= Just (Sc_runtime.sc_complete_child tid parent value sc);
                dr_step_counter= dr_st.dr_step_counter + 1;
              |>
          end) >> ND.return SC_continue
    | Core_reduction.Step_done2 value ->
        ND.update (fun dr_st ->
          let dr_st = sc_discard_scopes dr_st in
          <| dr_st with core_state= prepare_exit dr_st.core_state value |>) >> ND.return SC_halted
    | Core_reduction.Step_fs2 annotation _ th_st resume_fs operation_m ->
        sc_begin_request tid (Sc_runtime.SC_runtime "Core filesystem/runtime operation") annotation >>
        liftCore_run operation_m >>= function
          | Core_reduction.FS_done value ->
              ND.update (fun dr_st ->
                let dr_st = sc_discard_scopes dr_st in
                <| dr_st with core_state= prepare_exit dr_st.core_state value |>) >> ND.return SC_halted
          | Core_reduction.FS_oper operation ->
              ND.get >>= fun dr_st ->
              drive_fs_step_with
                (fun after result ->
                  match result.Core_run.arena with
                    | Core.Expr _ (Core.Epure pe) -> resume_fs (sc_receipt_from_state after) pe
                    | _ -> error "SC runtime completion did not return a pure expression"
                  end) tid th_st dr_st operation >> ND.return SC_continue
        end
    | Core_reduction.Step_join2 _ predecessors th_st ->
        ND.update (fun dr_st -> match dr_st.sc_state with
          | Nothing -> dr_st
          | Just sc -> <| dr_st with sc_state= Just (Sc_runtime.sc_note_join tid predecessors sc) |>
        end) >> resume th_st
    | Core_reduction.Step_blocked2 -> ND.return SC_blocked
    | Core_reduction.Step_error2 message -> ND.kill (ND.Other (DErr_core_run (Illformed_program message)))
  end

let sc_thread_choices tid th_info sc dr_st =
  match List.lookup tid dr_st.sc_pending with
    | Just pending -> [(tid, pending)]
    | Nothing -> List.map (fun step -> (tid, step))
        (List.filter (function Core_reduction.Step_blocked2 -> false | _ -> true end)
          (Core_reduction.step_ctx_with (Just (Sc_runtime.sc_control tid sc))
            dr_st.layout_state dr_st.core_file dr_st.core_extern tid th_info))
  end

(* Core component choices, before saved-service and filesystem ownership. *)
let sc_choices sc dr_st =
  List.concat (List.map (fun (tid, th_info) -> sc_thread_choices tid th_info sc dr_st)
    dr_st.core_state.Core_run.thread_states)

let sc_saved_thread saved = saved.sc_saved_request.Sc_runtime.sc_request_thread

let sc_drop_saved tid services = <| services with sc_suspended_services=
  List.filter (fun saved -> sc_saved_thread saved <> tid) services.sc_suspended_services |>

let sc_finish_service tid services =
  let services = sc_drop_saved tid services in
  <| services with sc_filesystem_owner=
    if services.sc_filesystem_owner = Just tid then Nothing else services.sc_filesystem_owner |>

let sc_is_filesystem_step = function
  | Core_reduction.Step_fs2 _ _ _ _ _ -> true
  | _ -> false
end

let sc_step_may_suspend = function
  | Core_reduction.Step_memop_request2 _ _ _ _ _ _ _ -> true
  | Core_reduction.Step_fs2 _ _ _ _ _ -> true
  | _ -> false
end

let sc_filesystem_available tid services =
  match services.sc_filesystem_owner with
    | Nothing -> true
    | Just owner -> owner = tid
  end

(* Configuration failure is an explicit port/protocol failure. It is not C UB. *)
let sc_memory_mode enabled state =
  match Mem.set_suspending enabled state.layout_state with
    | Nothing -> (Just (DErr_concurrency Sc_runtime.SC_fault_suspension_unavailable), state)
    | Just memory -> (Nothing, <| state with layout_state= memory |>)
  end

let sc_restore_service saved state =
  match state.sc_state with
    | Nothing -> (Just (DErr_concurrency Sc_runtime.SC_fault_resume_outside_mode), state)
    | Just current -> (Nothing, <| state with sc_state= Just <| current with
        Sc_runtime.sc_current_request= Just saved.sc_saved_request;
        Sc_runtime.sc_current_effects= saved.sc_saved_effects;
      |> |>)
  end

let sc_machine_return services progress state =
  let (failure, driver) = sc_memory_mode false state.sc_driver_state in
  let after = <| sc_driver_state= driver; sc_service_state= services |> in
  match failure with
    | Nothing -> (ND.NDactive progress, after)
    | Just reason -> (ND.NDkilled (ND.Other reason), after)
  end

(* Interpret ONE selected service before binding the global scheduler loop.
   Ordinary ND alternatives are preserved. Only typed suspension returns to
   scheduling; every failure retains the full current machine configuration. *)
let rec sc_capture_service tid computation = ND.ND (fun machine ->
  let ND.ND run = computation in
  let (action, driver) = run machine.sc_driver_state in
  let after = <| machine with sc_driver_state= driver |> in
  match action with
    | ND.NDactive progress ->
        sc_machine_return (sc_finish_service tid after.sc_service_state) progress after
    | ND.NDkilled reason -> (ND.NDkilled reason, after)
    | ND.NDsuspend continuation ->
        match driver.sc_state with
          | Nothing -> (ND.NDkilled (ND.Other (DErr_concurrency Sc_runtime.SC_fault_suspend_outside_mode)), after)
          | Just current ->
              match current.Sc_runtime.sc_current_request with
                | Nothing -> (ND.NDkilled (ND.Other (DErr_concurrency Sc_runtime.SC_fault_suspend_no_owner)), after)
                | Just request ->
                    if request.Sc_runtime.sc_request_thread <> tid then
                      (ND.NDkilled (ND.Other (DErr_concurrency Sc_runtime.SC_fault_suspend_wrong_thread)), after)
                    else
                      let saved = <| sc_saved_request= request;
                        sc_saved_effects= current.Sc_runtime.sc_current_effects;
                        sc_saved_computation= continuation |> in
                      let services = sc_drop_saved tid after.sc_service_state in
                      let services = <| services with sc_suspended_services=
                        saved :: services.sc_suspended_services |> in
                      sc_machine_return services SC_continue after
              end
        end
    | ND.NDguard info condition continuation ->
        (ND.NDguard info condition (sc_capture_service tid continuation), after)
    | ND.NDbranch info condition first second ->
        (ND.NDbranch info condition (sc_capture_service tid first) (sc_capture_service tid second), after)
    | ND.NDnd info choices ->
        (ND.NDnd info (List.map (fun (label, next) -> (label, sc_capture_service tid next)) choices), after)
    | ND.NDstep info choices ->
        (ND.NDstep info (List.map (fun (label, next) -> (label, sc_capture_service tid next)) choices), after)
  end)

(* A paused thread never re-evaluates its Core arena just to discard the result.
   Lookup compares thread identifiers only, never saved computations. *)
let sc_machine_choices sc machine =
  let state = machine.sc_driver_state in
  let services = machine.sc_service_state in
  List.concat (List.map (fun (tid, th_info) ->
    match List.find (fun saved -> sc_saved_thread saved = tid) services.sc_suspended_services with
      | Just saved -> [SC_resume_service saved]
      | Nothing -> List.map (fun (_, step) -> SC_start_service tid step)
          (List.filter (fun (_, step) ->
              not (sc_is_filesystem_step step) || sc_filesystem_available tid services)
            (sc_thread_choices tid th_info sc state))
    end) state.core_state.Core_run.thread_states)

let sc_start_machine_choice choice = ND.ND (fun machine ->
  let (tid, computation, enabled, initial_failure, driver, services) =
    match choice with
      | SC_start_service tid step ->
          let services = sc_drop_saved tid machine.sc_service_state in
          let services = if sc_is_filesystem_step step then
              <| services with sc_filesystem_owner= Just tid |> else services in
          (tid, sc_service_step tid step, sc_step_may_suspend step, Nothing,
            machine.sc_driver_state, services)
      | SC_resume_service saved ->
          let tid = sc_saved_thread saved in
          let (failure, driver) = sc_restore_service saved machine.sc_driver_state in
          (tid, saved.sc_saved_computation, true, failure, driver,
            sc_drop_saved tid machine.sc_service_state)
    end in
  let prepared = <| sc_driver_state= driver; sc_service_state= services |> in
  match initial_failure with
    | Just reason -> (ND.NDkilled (ND.Other reason), prepared)
    | Nothing ->
        let (failure, driver) = sc_memory_mode enabled driver in
        let prepared = <| prepared with sc_driver_state= driver |> in
        match failure with
          | Just reason -> (ND.NDkilled (ND.Other reason), prepared)
          | Nothing -> let ND.ND run = sc_capture_service tid computation in run prepared
        end
  end)

(* This is the authoritative complete-machine selection, including saved
   services. Core-only sc_choices remains a separately named component view. *)
let sc_step () =
  ND.get >>= fun machine ->
  match machine.sc_driver_state.sc_state with
    | Nothing -> ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_uninitialized))
    | Just sc ->
        match sc_machine_choices sc machine with
          | [] -> ND.update (fun state -> <| state with sc_driver_state=
              <| state.sc_driver_state with blocked= true |> |>) >> ND.return SC_blocked
          | choices -> ND.pick (SK_misc ["SC thread/Core/service step"]) choices >>= sc_start_machine_choice
        end
  end

let rec sc_driver_machine () =
  sc_step () >>= function
    | SC_continue -> sc_driver_machine ()
    | SC_halted -> ND.return ()
    | SC_blocked -> ND.return ()
  end

(* The existing batch observation exposes driver_state. Retain auxiliary
   machine state in EACH continuation; a getter that recreates empty services
   at each node would lose paused work. Direct sc_step preserves full state. *)
let rec sc_project services computation = ND.ND (fun driver ->
  let ND.ND run = computation in
  let (action, machine) = run <| sc_driver_state= driver; sc_service_state= services |> in
  let services = machine.sc_service_state in
  let driver = machine.sc_driver_state in
  match action with
    | ND.NDactive value -> (ND.NDactive value, driver)
    | ND.NDkilled reason -> (ND.NDkilled reason, driver)
    | ND.NDsuspend continuation -> (ND.NDsuspend (sc_project services continuation), driver)
    | ND.NDguard info condition continuation ->
        (ND.NDguard info condition (sc_project services continuation), driver)
    | ND.NDbranch info condition first second ->
        (ND.NDbranch info condition (sc_project services first) (sc_project services second), driver)
    | ND.NDnd info choices ->
        (ND.NDnd info (List.map (fun (label, next) -> (label, sc_project services next)) choices), driver)
    | ND.NDstep info choices ->
        (ND.NDstep info (List.map (fun (label, next) -> (label, sc_project services next)) choices), driver)
  end)


val     driver2: bool -> driverM unit
let rec driver2 with_concurrency =
  if with_concurrency then
    sc_project sc_empty_services (sc_driver_machine ())
  else
  let () = Debug.print_debug 2 [] (fun () -> "ENTERING Driver.driver2") in
  new_drive_core_threads   () >>= fun tid_steps ->
  ND.get >>= fun post_core_dr_st ->
  
  (* TODO: hackish *)
  let _non_blocked_th_sts = List.filter (fun (tid, th_info) ->
    List.any (fun step -> step <> Core_reduction.Step_blocked2) $
      Core_reduction.step_ctx post_core_dr_st.layout_state post_core_dr_st.core_file post_core_dr_st.core_extern tid th_info
  ) post_core_dr_st.core_state.Core_run.thread_states in
  
  begin if Global.current_execution_mode () = Just Global.Random then
    (* HACK The problem is that some threads are blocked (they wait
       for other threads to finish. If we randomly pick that thread to
       execute, there will not be any steps to execute, and the whole
       execution comes to a halt. To properly solve this, we need to
       implement back tracking. Since we haven't, we temporarily
       switch to exhaustive mode and also compute the steps of the
       other threads. *)
(*
    ND.bindExhaustive (ND.pick (SK_misc ["driver 2"]) non_blocked_th_sts)
                      (fun (tid, th_info) ->
                       ND.pick (SK_misc ["driver 3"]) $
                        Core_reduction.step_ctx post_core_dr_st.layout_state post_core_dr_st.core_file post_core_dr_st.core_extern tid th_info)
*)
    ND.bindExhaustive
      (ND.pick (SK_misc ["driver 2"]) tid_steps)
      (fun (tid, step_opt) ->
         let () = Debug.print_debug 3 [] (fun () ->
           show tid ^ " ==> " ^ Maybe.maybe "Nothing" show step_opt
         ) in
         match step_opt with
           | Just step ->
               process_core_step2 with_concurrency driver2 step
           | Nothing ->
               (* TODO: hack hack, should just exit *)
               ND.return ()
         end)
   else begin
    let non_blocked =
      List.filter (fun (tid, step_opt) ->
        step_opt <> Just Core_reduction.Step_blocked2
      ) tid_steps in
    begin
      if List.length non_blocked = 0 then
        let () = Debug.print_debug 5 [] (fun () ->
          "|tid_steps| = " ^ show (List.length tid_steps) ^ "\n" ^
          show tid_steps
        ) in
        ND.return ()
      else
        ND.return ()
    end >>= fun () ->
    ND.pick (SK_misc ["driver non_blocked"]) non_blocked >>= function
      | (_, Nothing) ->
          (* TODO: hack hack, should just exit *)
          ND.return ()
      | (_, Just step) ->
      process_core_step2 with_concurrency driver2 step
    end
    (*
    ND.pick (SK_misc ["driver 4"]) non_blocked_th_sts >>= fun (tid, th_info) ->
    ND.pick (SK_misc ["driver 5"]) (Core_reduction.step_ctx post_core_dr_st.layout_state post_core_dr_st.core_file post_core_dr_st.core_extern tid th_info)
      >>= (process_core_step2 with_concurrency driver2)
    *)
    end
  end









val     hack: map Symbol.sym Symbol.sym -> list (map Symbol.sym Core.value) -> Mem.mem_state -> Core.file Core_run.core_run_annotation -> map Symbol.sym Core.object_value -> Core.pexpr -> Core.value
let rec hack core_extern env mem_st core_file concur_sym_map pexpr =
  let () = Debug.print_debug 2 [] (fun () -> "ENTERING Driver.hack") in
  match Core_eval.step_eval_pexpr 0 (Loc.other "Driver.hack") Nothing core_extern env (Just mem_st) core_file false pexpr with
    | Exception.Result (Undefined.Defined pexpr') ->
        match Core_aux.valueFromPexpr pexpr' with
          | Just cval ->
              cval
          | Nothing ->
              hack core_extern env mem_st core_file concur_sym_map pexpr'
        end
    | _ ->
        error ("Driver.hack, UNDEF/ERROR:" ^ Pp.stringFromCore_pexpr pexpr)
end



type driver_result = <|
  dres_blocked: bool;
  dres_concurrency_state: Cmm_op.symState;
  dres_driver_steps: nat;
  dres_core_value: Core.value;
  dres_stdout: string;
  dres_stderr: string;
|>


val finalize: string -> driver_state -> driver_result (* (string * (bool * Cmm_op.symState * Core.value) * (nat * nat)) *)
let finalize debug_str dr_st =
  match dr_st.core_state.Core_run.thread_states with
    | [(tid, (_, th_st))] ->
        let cval = hack dr_st.core_extern th_st.Core_run.env dr_st.layout_state dr_st.core_file dr_st.symbolic_assoc
            match Core_aux.to_pure th_st.Core_run.arena with
(*
              | Just (Core.PEval (Core.Vinteger ival)) ->
                  let Just symb = Mem_aux.symbolicFromIntegerValue ival in
                  Core_aux.unsymbolify symb
*)
              | Just pe ->
                  pe
              | Nothing ->
                  error ("Driver.finalize: the arena wasn't pure ==> " ^ Pp.stringFromCore_expr th_st.Core_run.arena)
            end in
        <|
          dres_blocked= dr_st.blocked;
          dres_concurrency_state= dr_st.concurrency_state;
          dres_driver_steps= dr_st.dr_step_counter;
          dres_core_value= cval;
          dres_stdout= List.foldr String.stringAppend "" (Dlist.toList dr_st.core_state.Core_run.io.Core_run.stdout);
          dres_stderr= List.foldr String.stringAppend "" (Dlist.toList dr_st.core_state.Core_run.io.Core_run.stderr);
        |>
    | xs ->
        let () = Debug.print_debug 3 [Debug.DB_driver] (fun () -> "ERROR (end of the Driver)\n" ^ stringFromCore_core_state dr_st.core_state) in (* DEBUG *)
        error ("BOOM finalize [" ^ debug_str ^ "]")
  end







(* TODO: it is problematic for proofy backend that this function may diverge *)
(* TODO: HACK *)
(* C1 (effect retirement): the record builder is factored out so the
   const-expr mini-run can build the state from an EXPLICITLY threaded
   supply (initial_driver_state_given) while the production entry
   below keeps the one supply draw (Lean: supply-lifted via
   initial_core_run_state — signature Nat -> file -> fs_state ->
   driver_state * Nat, entry shape (b); OCaml: unchanged behavior, the
   run-state redirect carries no draw). *)
let initial_driver_state_with address_space_top run_st file fs_state =
  <|
    core_file=         file;
    core_extern=       Core_linking.create_extern_symmap file;
    core_state=        Core_run.initial_core_state;
    core_run_state=    run_st;
    layout_state=      Mem.initial_mem_state address_space_top;
    concurrency_state= Cmm_op.symInitialState Cmm_op.symInitialPre;
    fs_state=          fs_state;
    fs_boundary_failure= Nothing;
    trace=             [];
    sc_state=          Nothing;
    sc_pending=        [];
    sc_findings= Sc_candidate.sc_no_findings;
    sc_global_bindings= [];
    sc_origins= Nothing;
    sc_candidate= Nothing;
    symbolic_assoc=    Map.empty;
    blocked=           false;
    dr_step_counter=   0;
  |>

(* address-space-bound slice (2026-09-17): the address-space top is the FIRST explicit
   parameter of every entry (the Lean supply binder the backend inserts stays ahead of
   it); a consumer theorem quantifies it. *)
let initial_driver_state address_space_top file fs_state =
  initial_driver_state_with address_space_top (Core_run.initial_core_run_state (Caux.collect_labeled_continuations_NEW file)) file fs_state

(* the explicit-supply variant for the const-expr mini-run: consumes
   exactly one draw (the run-seed), mirroring the lifted entry above *)
let initial_driver_state_given sup address_space_top file fs_state =
  ( initial_driver_state_with address_space_top (Core_run.initial_core_run_state_given sup (Caux.collect_labeled_continuations_NEW file)) file fs_state
  , sup+1 )


val spawn_thread: maybe Mem.thread_id -> Core_run.thread_state -> driverM Mem.thread_id
let driver_spawn_thread parent_tid_opt th_st =
  ND.get >>= fun dr_st ->
  let ((tid, core_st'), run_st') = State.runStateM (
    Core_run.spawn_thread parent_tid_opt th_st dr_st.core_state
  ) dr_st.core_run_state in
  ND.update (fun dr_st -> <| dr_st with
    core_state= core_st';
    core_run_state= run_st';
  |>) >>
  ND.return tid
let inline spawn_thread = driver_spawn_thread


val update_thread_state: Mem.thread_id -> Core_run.thread_state -> driverM unit
let driver_update_thread_state tid th_st =
  ND.update (fun dr_st ->
    <| dr_st with core_state= Core_run.update_thread_state tid th_st dr_st.core_state |>
  )
let inline update_thread_state = driver_update_thread_state


(* The optional receipt is installed by the SAME existing ND.update which
   binds a successful global initializer. No extra step, read or event occurs. *)
let initialize_thread_state_with_binding binding tid th_st =
  ND.update (fun dr_st ->
    let annotation = match dr_st.sc_state with
      | Nothing -> Nothing
      | Just _ -> Just (sc_initial_annotation tid dr_st)
      end in
    let th_st' = Sc_global_bindings.sc_initialization_thread annotation th_st in
    let bindings = match binding with
      | Nothing -> dr_st.sc_global_bindings
      | Just (symbol, value) -> Sc_global_bindings.sc_note_global_binding
          dr_st.sc_state tid dr_st.dr_step_counter symbol value dr_st.sc_global_bindings
      end in
    <| dr_st with core_state= Core_run.update_thread_state tid th_st' dr_st.core_state;
       sc_global_bindings= bindings |>)

let initialize_thread_state tid th_st =
  initialize_thread_state_with_binding Nothing tid th_st


val driver_globals: bool -> Core.file Core_run.core_run_annotation -> driverM Mem.thread_id
let driver_globals with_concurrency file =
  (* spawning a thread for the initialisation of globals, and later the execution of main *)
  spawn_thread Nothing <|
    (* NOTE: the pure(unit) is just a placeholder, the thread is given its actual state later *)
    Core_run.arena=  Core.Expr [] (Core.Epure (Core.Pexpr [] () (Core.PEval Core.Vunit)));
    Core_run.stack=  Core_run.Stack_empty (*Core_run.push_empty_continuation Nothing Core_run.empty_stack*);
    Core_run.errno=  Mem.null_ptrval Ctype.signed_int;
    Core_run.env= [Map.empty];
    Core_run.current_loc= Loc.unknown;
    Core_run.exec_loc= Core_run.ELoc_globals;
    Core_run.current_proc_opt= Nothing;
  |> >>= fun tid0 ->
  
  ND.read (fun dr_st ->
    dr_st.core_file.Core.globs
  ) >>= fun globs ->
  let glob_defs = List.reverse $ List.foldl (fun acc (sym, glb) ->
    match glb with
    | Core.GlobalDef (bTy, _) e -> (sym, bTy, e) :: acc
    | Core.GlobalDecl _ -> acc
    end) [] globs
  in
  ND.mapM_ (fun (glob_sym, glob_bTy, expr) ->
    let () = Debug.print_debug 6 [Debug.DB_driver] (fun () ->      (* DEBUG *)
      "Starting the evaluation of global `" ^ show glob_sym ^ "'"  (* DEBUG *)
    ) in                                                           (* DEBUG *)
    (* setting up the initialisation of the current global in thread 0 *)
    get_thread_states >>= function
      | [(_, (_, th_st))] ->
        initialize_thread_state tid0 <|
          (* the previously evaluated globals are substituted in the body of the
             global we are about to evaluate *)
          Core_run.arena= expr;
          Core_run.stack= Core_run.Stack_empty (*Core_run.push_empty_continuation Nothing Core_run.empty_stack*);
          Core_run.env= th_st.Core_run.env;
          Core_run.errno=  Mem.null_ptrval Ctype.signed_int;
          Core_run.current_loc= Loc.other ("global(" ^ show glob_sym ^ ")"); (* TODO: preserve locations in Core.globs *)
          Core_run.exec_loc= Core_run.ELoc_globals;
          Core_run.current_proc_opt= Nothing;
        |>
      | _ ->
          error "ERROR (in Driver, global init didn't evaluate to value)"
    end >>= fun () ->
    
    (* evaluation of the initialisation *)
    driver2 with_concurrency >>= fun () ->
    
    get_thread_states >>= function
      | [(_, (_, th_st))] ->
          (* TODO: technically the arena should always be a value at this point *)
          match Core_aux.to_pure th_st.Core_run.arena with
            | Just pe ->
                match Core_aux.valueFromPexpr pe with
                  | Nothing ->
                      error "WIP: driver_globals"
                  | Just cval ->
                      initialize_thread_state_with_binding (Just (glob_sym,cval)) tid0
                        <| th_st with
                            Core_run.env = Core_aux.update_env (Core.Pattern [] (Core.CaseBase (Just (glob_sym), glob_bTy))) cval th_st.Core_run.env
                        |>
                        (*

                      ND.update (fun dr_st ->
                        <| dr_st with
                          core_run_state=
                            <| dr_st.core_run_state with Core_run.env= Core_aux.update_env (Core.Pattern [] (Core.CaseBase (Just (glob_sym), glob_bTy))) cval dr_st.core_run_state.Core_run.env |>
                        |>
                     ) *)
                end
            | Nothing ->
                error "TODO(msg): Driver.driver_globals, the end of the evaluation of a glob didn't produce a value"
          end
      | _ ->
          error "ERROR (in Driver, global init didn't evaluate to value)"
    end
  ) glob_defs >>
  ND.ND (fun dr_st -> (ND.NDactive tid0,
    sc_request_state tid0 (Sc_runtime.SC_runtime "startup argv/errno")
      (sc_initial_annotation tid0 dr_st) dr_st))



val pp_exeState: Cmm_op.symState -> string
declare ocaml target_rep function pp_exeState = `Pp_cmm.pp_execState`
declare lean target_rep function pp_exeState = `CerbPP.pp_exeState`



let prepare_main_args loc callconv tid0 main_sym arg_strs argc_sym argv_sym =
  (* memory_values to be stored in memory objects pointed to by the element of main.argv *)
  let args_mem_val_tys =
    List.map (fun arg_str ->
      let mem_vals =
        List.map (fun c ->
          (* TODO: fixing impl choice here (ASCII) *)
          Mem.integer_mval Ctype.Char (Decode.decode_character_constant (String.toString [c]))
        ) (String.toCharList arg_str) in
      (* NOTE: adding a null termination to the char array *)
      ( Mem.array_mval (mem_vals ++ [Mem.integer_mval Ctype.Char 0])
      , Ctype.Ctype [] (Ctype.Array Ctype.char (Just ((integerFromNat (List.length mem_vals)) + 1))) )
    ) arg_strs in

  let number_of_args = integerFromNat (List.length args_mem_val_tys) in

  (* allocating and initialising the objects pointed to by the elements of argv *)
  ND.foldlM (fun ptr_vals (arg_mem_val, arg_ty) ->
    driver_liftMem (
      Mem.bind (Mem.allocate_object tid0 (Symbol.PrefOther "argv refs") (Mem.alignof_ival arg_ty) arg_ty Nothing Nothing) (fun ptr_val ->
        Mem.bind (Mem.store (Loc.other "argv refs init") arg_ty false ptr_val arg_mem_val) (fun _ ->
          Mem.return (ptr_val :: ptr_vals)
        )
      )
    )
  ) [] args_mem_val_tys >>= fun ptr_vals_rev ->

  (* allocating and initialising an object for main.argv *)
  (* NOTE: the element argv[argc] is required to be a null pointer
      by the STD, hence argv has one more element than the number
      of supplied arguments *)
 driver_liftMem begin
    let pref = Symbol.PrefSource loc [main_sym; argv_sym(*TODO: change the sym?*)] in
    let argv_array_ty = Ctype.Ctype [] (Ctype.Array Ctype.pointer_to_char (Just (1 + (integerFromNat (List.length ptr_vals_rev))))) in
    let argv_array_mem_val = Mem.array_mval (
      List.map (Mem.pointer_mval Ctype.char) (List.reverse (Mem.null_ptrval Ctype.char :: ptr_vals_rev))
    ) in
    Mem.bind
      (Mem.allocate_object tid0 pref (Mem.alignof_ival argv_array_ty) argv_array_ty Nothing Nothing) (fun ptr_val ->
    Mem.bind
      (Mem.store (Loc.other "argv array init") argv_array_ty false ptr_val argv_array_mem_val) (fun _ ->
      ND.return ptr_val
    ))
  end >>= fun argv_array_ptr_val ->
    
  match callconv with
    | Core.Normal_callconv ->
        let argc_mem_val = Mem.integer_mval (Ctype.Signed Ctype.Int_) number_of_args in
        driver_liftMem begin
          let pref = Symbol.PrefSource loc [main_sym; argc_sym] in
          Mem.bind (Mem.allocate_object tid0 pref (Mem.alignof_ival Ctype.signed_int) Ctype.signed_int Nothing Nothing) (fun argc_ptr_val ->
          Mem.bind (Mem.store (Loc.other "argc init") Ctype.signed_int false argc_ptr_val argc_mem_val) (fun _ ->

          (* NOTE: because of argument promotions, the char *argv[] is turned into a char **argv
              so two objects are allocated: an array and a pointer to that array (which is what argv designate) *)
          let pref = Symbol.PrefSource loc [main_sym; argv_sym] in
          let argv_ty = Ctype.mk_ctype_pointer Ctype.no_qualifiers Ctype.pointer_to_char in
          Mem.bind
            (Mem.allocate_object tid0 pref (Mem.alignof_ival argv_ty) argv_ty Nothing Nothing) (fun argv_ptr_val ->
          Mem.bind
            (Mem.store (Loc.other "argv init") argv_ty false argv_ptr_val (Mem.pointer_mval Ctype.pointer_to_char argv_array_ptr_val)) ( fun _ ->

            Mem.return
              ( Core.Vobject (Core.OVpointer argc_ptr_val)
              , Core.Vobject (Core.OVpointer argv_ptr_val) )
          ))))
        end
    | Core.Inner_arg_callconv ->
        let argc_cval = Core.Vloaded (Core.LVspecified (Core.OVinteger (Mem.integer_ival number_of_args))) in
        let argv_cval = Core.Vloaded (Core.LVspecified (Core.OVpointer argv_array_ptr_val)) in
        ND.return (argc_cval, argv_cval)
  end




val drive_recorded: bool -> Core.file Core_run.core_run_annotation -> list string -> driverM driver_result
let drive_recorded (with_concurrency: bool) file (arg_strs: list string) =
  (* Setting the read-only tag definitions (used by the memory model) *)
  (* first we execute the body of global definitions and remove their symbols
     from the rest of the program *)
  driver_globals with_concurrency file >>= fun tid0 (*, post_globals_dr_st) *) ->
  ND.get >>= fun post_globals_dr_st ->
  
  (* we need a startup function to have been declared *)
  match post_globals_dr_st.core_file.Core.main with
    | Just sym ->
        ND.return sym
    | Nothing ->
        ND.kill (ND.Other (DErr_other "no startup function was declared"))
  end >>= fun main_sym ->
  
  (* setting the arena of thread 0 to the body of the main function *)
  match Map.lookup main_sym post_globals_dr_st.core_file.Core.funs with
    | Nothing ->
        ND.kill (ND.Other (DErr_other "couldn't find the startup function"))
    
    | Just decl ->
        match decl with
          | Core.Fun  _ params pe ->
              ND.return (Loc.other "main args", params, Core.Expr [] (Core.Epure pe))
          | Core.ProcDecl _ _ _ ->
              ND.kill (ND.Other (DErr_other "the startup function has no definition"))
          | Core.BuiltinDecl _ _ _ ->
              ND.kill (ND.Other (DErr_other "the startup function has no definition"))
          | Core.Proc loc _ _ params e ->
              ND.return (loc, params, e)
        end >>= fun (loc, params, expr) ->
        
        match params with
          | [(argc_sym, _); (argv_sym, _)] ->

(*
              (* memory_values to be stored in memory objects pointed to by
                 the element of main.argv  *)
              let args_mem_val_tys =
                List.map (fun arg_str ->
                  let mem_vals =
                    List.map (fun c ->
                      (* TODO: fixing impl choice here (ASCII) *)
                      Mem.integer_mval Ctype.Char $ Decode.decode_character_constant (String.toString [c])
                    ) (String.toCharList arg_str) in
                  (* NOTE: adding a null termination to the char array *)
                  (
                    Mem.array_mval $ mem_vals ++ [Mem.integer_mval Ctype.Char 0],
                    Ctype.Ctype [] (Ctype.Array Ctype.char (Just ((integerFromNat (List.length mem_vals)) + 1)))
                  )
                ) arg_strs in
              
              (* memory value to be stored in the memory object pointed to by main.argc *)
              let number_of_args = integerFromNat (List.length args_mem_val_tys) in
              let argc_mem_val = Mem.integer_mval (Ctype.Signed Ctype.Int_) number_of_args in
              
              (* begin if false (*Global.has_switch Global.SW_inner_arg_temps*) then
                (* in this switch (for CN) Core procedures elaborating C functions
                   receive values (and to the temp allocation themselves) *)
                   ND.return (Core.Vobject (Core.OVinteger (Mem.integer_ival number_of_args)))
              else *)
                (* allocating and initialising an object for main.argc *)
                driver_liftMem (
                  Mem.bind (Mem.allocate_object tid0 (Symbol.PrefSource loc [main_sym; argc_sym])
                              (Mem.alignof_ival Ctype.signed_int) Ctype.signed_int Nothing Nothing) (fun ptr_val ->
                    Mem.bind (Mem.store (Loc.other "argc init") Ctype.signed_int false ptr_val argc_mem_val) (fun _ ->
                      Mem.return (Core.Vobject (Core.OVpointer ptr_val))
                    )
                  )
                )
              (*end*) >>= fun argc_cval ->
              
              (* allocating and initialising the objects pointed to by the elements of argv *)
              ND.foldlM (fun ptr_vals (arg_mem_val, arg_ty) ->
                driver_liftMem (
                  Mem.bind (Mem.allocate_object tid0 (Symbol.PrefOther "argv refs") (Mem.alignof_ival arg_ty) arg_ty Nothing Nothing) (fun ptr_val ->
                    Mem.bind (Mem.store (Loc.other "argv refs init") arg_ty false ptr_val arg_mem_val) (fun _ ->
                      Mem.return (ptr_val :: ptr_vals)
                    )
                  )
                )
              ) [] args_mem_val_tys >>= fun ptr_vals_rev ->
              
              (* allocating and initialising an object for main.argv *)
              (* NOTE: the element argv[argc] is required to be a null pointer
                 by the STD, hence argv has one more element than the number
                 of supplied arguments *)
              let argv_array_elem_ty = Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers Ctype.char) in
              let argv_array_ty = Ctype.Ctype [] (Ctype.Array argv_array_elem_ty (Just (1 + (integerFromNat $ List.length ptr_vals_rev)))) in
              let argv_array_mem_val = Mem.array_mval $
                List.map (Mem.pointer_mval Ctype.char) (List.reverse ptr_vals_rev ++ [Mem.null_ptrval Ctype.char]) in
              driver_liftMem (
                Mem.bind (Mem.allocate_object tid0 (Symbol.PrefSource loc [main_sym; argv_sym(*TODO: change the sym?*)])
                            (Mem.alignof_ival argv_array_ty) argv_array_ty Nothing Nothing) (fun array_ptr_val ->
                Mem.bind (Mem.store (Loc.other "argv array init") argv_array_ty false array_ptr_val argv_array_mem_val) (fun _ ->
                
                (* NOTE: because of argument promotions, the char *argv[] is turned into a char **argv
                   so two objects are allocated: an array and a pointer to that array (which is what argv designate) *)
                let argv_ty = Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers (Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers Ctype.char))) in
                Mem.bind (Mem.allocate_object tid0 (Symbol.PrefSource loc [main_sym; argv_sym])
                            (Mem.alignof_ival argv_ty) argv_ty Nothing Nothing) (fun argv_ptr_val ->
                Mem.bind (Mem.store (Loc.other "argv init") argv_ty false argv_ptr_val
                            (Mem.pointer_mval (Ctype.Ctype [] (Ctype.Pointer Ctype.no_qualifiers Ctype.char)) array_ptr_val)) ( fun _ ->

                Mem.return (Core.Vobject (Core.OVpointer argv_ptr_val))
                ))))
              ) >>= fun argv_cval ->
*)
              prepare_main_args loc file.Core.calling_convention tid0 main_sym arg_strs argc_sym argv_sym >>= fun (argc_cval, argv_cval) ->

              (* Adding the values of argc and argv to the Core symbol environment *)
              get_thread_states >>= function
                | [(_, (_, th_st))] ->
                  initialize_thread_state tid0
                    <| th_st with
                        Core_run.env =
                          match th_st.Core_run.env with
                            | [] ->
                                [Map.fromList [ (argc_sym ,argc_cval)
                                              ; (argv_sym, argv_cval) ]]
                            | (xs :: xs') ->
                                (Map.insert argc_sym argc_cval
                                  (Map.insert argv_sym argv_cval xs)) :: xs'
                          end
                   |>
                | _ ->
                    error "ERROR (in Driver 1)"
              end >>= fun () ->
              ND.return expr
          | _ ->
              ND.return expr
        end >>= fun expr ->
        
        (* allocating and initialising errno *)
        driver_liftMem (
          Mem.bind (Mem.allocate_object tid0 (Symbol.PrefOther "errno") (Mem.alignof_ival Ctype.signed_int) Ctype.signed_int Nothing Nothing) (fun ptr_val ->
            let zero = Mem.integer_value_mval (Ctype.Signed Ctype.Int_) (Mem.integer_ival 0) in
            Mem.bind (Mem.store (Loc.other "errno init") Ctype.signed_int false ptr_val zero) (fun _ ->
              Mem.return ptr_val
            )
          )
        ) >>= fun errno_ptr_val ->
        
        get_thread_states >>= function
          | [(_, (_, th_st))] ->
              initialize_thread_state tid0 <|
                Core_run.arena= expr;
                Core_run.stack= Core_run.Stack_empty (*Core_run.push_empty_continuation (Just main_sym) Core_run.empty_stack*);
                Core_run.errno= errno_ptr_val;
                Core_run.current_loc= Loc.other "Driver.drive";
                Core_run.exec_loc= Core_run.ELoc_normal [(main_sym, Loc.other "Driver.drive")];
                Core_run.env = th_st.Core_run.env;
                Core_run.current_proc_opt= Just main_sym;
              |>
          | _ ->
              error "ERROR (in Driver 2)"
        end >>
        driver2 with_concurrency >>
        
        if with_concurrency then
          ND.read (fun dr_st' ->
            if dr_st'.blocked then
              <|
                dres_blocked= true;
                dres_concurrency_state= dr_st'.concurrency_state;
                dres_driver_steps= dr_st'.dr_step_counter;
                dres_core_value= Core.Vunit; (* no return value; blocked flag is authoritative *)
                dres_stdout= List.foldr String.stringAppend "" (Dlist.toList dr_st'.core_state.Core_run.io.Core_run.stdout);
                dres_stderr= List.foldr String.stringAppend "" (Dlist.toList dr_st'.core_state.Core_run.io.Core_run.stderr);
              |>
            else finalize "drive recorded SC" dr_st')
        else
          ND.get >>= fun dr_st' ->
          ND.return (finalize "drive (without concur)" dr_st')

end

(* Interpret and classify the actual final journal. Prefix findings remain in
   driver state on every operational failure and are consulted independently
   of candidate consistency. This first adapter has explicit port obligations
   for location/value/lifetime cases whose composition is still unfinished. *)
let drive with_concurrency file args =
  if with_concurrency then
    sc_enable >> drive_recorded true file args >>= fun value ->
    ND.get >>= fun state ->
    match state.sc_state with
      | Nothing -> ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_uninitialized))
      | Just recorded ->
          let result = Sc_candidate.sc_classify_candidate (sc_interpret_driver state recorded) in
          let findings = Sc_candidate.sc_retain_findings result state.sc_findings in
          ND.update (fun state -> <| state with sc_candidate= Just result; sc_findings= findings |>) >>
          let interpretation = result.Sc_candidate.sc_class_interpretation in
          let issues = List.map Sc_candidate.sc_interpretation_issue_name interpretation.Sc_candidate.sc_candidate_issues in
          if not (Set.null findings.Sc_candidate.sc_found_data_races) then
            ND.kill (ND.Undef Loc.unknown [U.UB005_data_race])
          else if not (Set.null findings.Sc_candidate.sc_found_unsequenced_races) then
            ND.kill (ND.Undef Loc.unknown [U.UB035_unsequenced_race])
          else if not (List.null interpretation.Sc_candidate.sc_candidate_graph.Sc_graph.sc_graph_issues) then
            ND.kill (ND.Other (DErr_concurrency (Sc_runtime.SC_fault_protocol "source graph")))
          else if not (List.null recorded.Sc_runtime.sc_scopes.Sc_scopes.sc_scope_issues) then
            ND.kill (ND.Other (DErr_concurrency (Sc_runtime.SC_fault_protocol "call scopes")))
          else if not (List.null issues) then
            ND.kill (ND.Other (DErr_concurrency (Sc_runtime.SC_fault_interpretation issues)))
          else if not (Set.null findings.Sc_candidate.sc_found_atomic_sequencing) then
            ND.kill (ND.Other (DErr_concurrency Sc_runtime.SC_fault_atomic_sequencing))
          else if not (List.null result.Sc_candidate.sc_class_failed_checks) then
            ND.kill (ND.Other (DErr_concurrency
              (Sc_runtime.SC_fault_candidate_rejected result.Sc_candidate.sc_class_failed_checks)))
          else ND.return value
    end
  else drive_recorded false file args


(* === Totality declares (arc 3 sweep, 2026-08-18, final batch): Lean-target only.
   find_can_advance: structural list recursion -> automatic.
   Fuel cases: print_eval_conv_aux / driver2 are driver loops returning
   ndM; drive_nonmemory_steps_aux2 has a trailing curried list arg, so its
   arm is a lambda to the ND-killed value; hack is a step-until-value loop
   returning a bare value -> the opaque `fuelExhausted Vunit` sentinel
   (panics at runtime; a pure-return worker, request item 3).
   FUEL ARC (2026-09-03, docs/2026-09-02_fuel-arc-design.md section 1.2):
   the three ND-typed arms are the DISTINGUISHED kernel-transparent kill
   `NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg)`
   (= CerbND.fuelExhaustedKill), unwrapped — see nondeterminism.lem. === *)
declare {lean} termination_argument find_can_advance = automatic
declare {lean} fuel val print_eval_conv_aux = `ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))`
declare {lean} fuel val drive_nonmemory_steps_aux2 = `fun _ => ND (fun st => (NDkilled (Error0 CerbFuel.fuelExhaustedLoc CerbFuel.fuelExhaustedMsg), st))`
