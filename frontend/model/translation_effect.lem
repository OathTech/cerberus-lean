(* Effects for Translation: state *)
open import Pervasives Utils Show Show_extra State
import Boot Symbol Undefined Ctype AilTypesAux
import Core Core_aux Ctype

module C    = Core
module Caux = Core_aux

type wrapped_symbol = <|
  sym_sym: Symbol.sym;
  sym_pat: C.pattern;
  sym_pe: C.pexpr;
|>

type compound_literal_info =
  ( Loc.t
  * Symbol.prefix
  * Symbol.sym
  * bool (* is const *)
  * Ctype.ctype )

type elab_state = <|
  visible_objects_types: map Symbol.sym (Ctype.qualifiers * Ctype.ctype);
  visible_objects: list (list Symbol.sym); (* visible C objects with scoping (used to properly
                                              annotate Esave/Erun ctors) *)
  string_literals: list (Loc.t * Symbol.sym * Ctype.ctype * C.pexpr);
  compound_literals: list compound_literal_info;
  temporary_objects: list (wrapped_symbol * Ctype.ctype);
  visible_objects_types_markers_env: map nat (list (Symbol.sym * Ctype.ctype));

  cheri_const_alias: map Symbol.sym Symbol.sym;

  (* effect-retirement C1 (charter m1): the fresh-symbol supply for the
     elaboration cone, threaded through elabM. On the OCaml target this
     field is DEAD — the mints below redirect to the single ambient
     counter (Fork_renumber, arc-13 scheme R-B) — it serves the LEAN
     target only, seeded by the entry (translation.lem translate /
     mini_pipeline's local run) from the pipeline's single stream. *)
  fresh_supply: nat;

  errors: list string;
|>

type elab_ub_or_nd =
  | Elab_UB
  | Elab_ND

type elab_config = <|
  calling_convention: C.calling_convention;

  (* TODO: properly classify what the following configure *)
  is_PNVI: bool;
  is_CHERI: bool;
  is_CN: bool;
  strict_pointer_arith: bool;
  branching_on_unspec: elab_ub_or_nd;
(*
has_switch Global.SW_inner_arg_temps ---> USE calling_convention
*)
|>

let elab_config callconv is_PNVI is_CHERI is_CN strict_pointer_arith branching_on_unspec = <|
  calling_convention= callconv;
  is_PNVI= is_PNVI;
  is_CHERI= is_CHERI;
  is_CN= is_CN;
  strict_pointer_arith= strict_pointer_arith;
  branching_on_unspec= branching_on_unspec;
|>

(* C1: the initial elaboration state is seeded from the pipeline's single
   fresh-symbol stream (the fork's parameter on upstream's constant). *)
val elab_initial_state: nat -> elab_state
let elab_initial_state fresh_supply_seed = <|
  visible_objects_types= Map.empty;
  visible_objects= [[]];
  string_literals= [];
  compound_literals= [];
  temporary_objects= [];
  visible_objects_types_markers_env = Map.empty;
  cheri_const_alias= Map.empty;
  fresh_supply= fresh_supply_seed;
  errors = [];
|>

type elabM 'a =
  elab_config -> elab_state -> ('a * elab_state)

val elab_return: forall 'a. 'a -> elabM 'a
let elab_return x = fun _ st -> (x, st)

val elab_bind: forall 'a 'b. elabM 'a -> ('a -> elabM 'b) -> elabM 'b
let elab_bind m f =
  fun conf st ->
    let (a, st') = m conf st in
    f a conf st'

let rec elab_mapM_aux f conf acc st = function
  | [] -> (List.reverse acc, st)
  | x :: xs ->
      let (y, st') = f x conf st in
      (* NOTE: this MUST remain in tail position *)
      elab_mapM_aux f conf (y :: acc) st' xs
end
val elab_mapM: forall 'a 'b. ('a -> elabM 'b) -> list 'a -> elabM (list 'b)
let elab_mapM f xs =
  fun conf st -> elab_mapM_aux f conf [] st xs

let rec elab_foldlM_aux f conf acc st = function
  | [] -> (acc, st)
  | x :: xs ->
      let (acc', st') = f acc x conf st in
      elab_foldlM_aux f conf acc' st' xs
end
val elab_foldlM: forall 'a 'b. ('a -> 'b -> elabM 'a) -> 'a -> list 'b -> elabM 'a
let elab_foldlM f init xs = fun conf st -> elab_foldlM_aux f conf init st xs
(* merge-base bump stage 1 (2026-10-29): upstream's accumulator recursions are
   list-structural; without a declare lem-lean would emit `partial def` *)
declare {lean} termination_argument elab_mapM_aux = automatic
declare {lean} termination_argument elab_foldlM_aux = automatic


val elab_update: forall 'a. (elab_state -> elab_state) -> elabM unit
let elab_update f =
  fun _ st -> ((), f st)

let inline return = elab_return
let inline (>>=) = elab_bind
let inline mapM = elab_mapM
let inline foldlM = elab_foldlM



val read_config: elabM elab_config
let read_config =
  fun conf st -> (conf, st)

(* effect-retirement C1 (charter m1): the monadic fresh mints for the
   elaboration cone, replacing the ambient Symbol.fresh* draws at the
   19 live sites. The lem bodies thread elab_state.fresh_supply (the
   LEAN scheme, built on the pure Symbol.fresh_given_int exactly like
   core_run.lem's fresh_symbol'); the OCaml target redirects the int
   mint to the single ambient counter (Fork_renumber.fresh_elab_int),
   keeping the oracle on Cerb_fresh.int at the migrated positions.
   The oracle's dynamic draw SEQUENCE moves per the tolerated
   S0-measured class (charter section 3.6.1, Q1b TOLERATED). *)
val fresh_elab_int: elabM nat
let fresh_elab_int =
  fun _ st ->
    let n = st.fresh_supply in
    (n, <| st with fresh_supply= n+1 |>)
declare ocaml target_rep function fresh_elab_int = `Fork_renumber.fresh_elab_int`

val fresh_elab_sym: Symbol.symbol_description -> elabM Symbol.sym
let fresh_elab_sym descr =
  fresh_elab_int >>= fun n ->
  return (Symbol.set_symbol_description (Symbol.fresh_given_int (Symbol.digest ()) n) descr)

val fresh_elab_pretty_with_id: (nat -> string) -> elabM Symbol.sym
let fresh_elab_pretty_with_id mkStr =
  fresh_elab_int >>= fun n ->
  return (Symbol.set_symbol_description (Symbol.fresh_given_int (Symbol.digest ()) n) (Symbol.SD_Id (mkStr n)))

(* Run a supply-consuming sub-computation against the elaboration
   supply: f receives the current supply and returns (result, final
   supply). Used by the erase_loop_control pass (m1b). Pure threading —
   on OCaml this shuttles the dead field (the sub-computation's own
   mints redirect ambiently). *)
val with_fresh_supply: forall 'a. (nat -> ('a * nat)) -> elabM 'a
let with_fresh_supply f =
  fun _ st ->
    let (a, sup') = f st.fresh_supply in
    (a, <| st with fresh_supply= sup' |>)

(* TODO: this does not need to be in the monad, but it is useful to unsure
   proper ordering (for "intuitive" sym number) *)
val wrapped_fresh_symbol: C.core_base_type -> elabM wrapped_symbol
let wrapped_fresh_symbol bTy =
  fresh_elab_sym Symbol.SD_None >>= fun sym ->
  return <|sym_sym= sym; sym_pat= Caux.mk_sym_pat sym bTy; sym_pe= Caux.mk_sym_pe sym |>

val wrapped_fresh_symbol_: Symbol.symbol_description -> C.core_base_type -> elabM (Symbol.sym * C.pattern * C.pexpr)
let wrapped_fresh_symbol_ descr bTy =
  fresh_elab_sym descr >>= fun sym ->
  return (sym, Caux.mk_sym_pat sym bTy, Caux.mk_sym_pe sym)


(* TODO: this does not need to be in the monad *)
(* val wrapped_fresh_symbol_descr: C.core_base_type -> Symbol.symbol_description -> elabM (Symbol.sym * C.pattern * C.pexpr)
 * let wrapped_fresh_symbol_descr bTy descr =
 *   let sym = Symbol.fresh_description descr in
 *   return (sym, Caux.mk_sym_pat sym bTy, Caux.mk_sym_pe sym) *)

val cheri_const_alias_map: elabM (map Symbol.sym Symbol.sym)
let cheri_const_alias_map = fun _ st ->
  (st.cheri_const_alias, st)

val with_block_objects:
  forall 'a.
  list (Symbol.sym * (Ctype.qualifiers * Ctype.ctype)) ->
  elabM 'a ->
  elabM
    ( list (Symbol.sym * (Ctype.qualifiers * Ctype.ctype * Symbol.sym))
    * list compound_literal_info
    * 'a )
let with_block_objects binds ma = fun conf st ->
  (* C1 m1: the const-alias mints draw from the threaded supply (the
     fold threads the elab_state through fresh_elab_int; on OCaml the
     redirected mint draws ambiently and returns the state unchanged).
     The mints keep their run-time firing position (inside this state
     function); the fold's LIST order is unchanged. *)
  let (new_aliases, cheri_const_alias, st0) = List.foldl (fun (xs_acc, map_acc, stx) (sym, (qs, ty)) ->
    (* TODO: fail if sym IN acc *)
    if qs.Ctype.const then
      let (n, stx') = fresh_elab_int conf stx in
      let sym' = Symbol.fresh_given_int (Symbol.digest ()) n in
      ((sym, (qs, ty, sym')) :: xs_acc, Map.insert sym sym' map_acc, stx')
    else
      (xs_acc, map_acc, stx)
  ) ([], st.cheri_const_alias, st) binds in
  let st' = <| st0 with
    visible_objects_types= List.foldl (fun acc (sym, qs_ty) -> Map.insert sym qs_ty acc) st.visible_objects_types binds;
    visible_objects= (List.map fst binds) :: st.visible_objects;
    compound_literals= [];
    cheri_const_alias = cheri_const_alias;
  |> in
  let (a, st'') = ma conf st' in
  ((new_aliases, st''.compound_literals, a), <| st'' with
    visible_objects=
      match st''.visible_objects with
      | _ :: xs -> xs
      | _       -> error "[Translation.E.with_block_objects] found an ill-formed scope stack."
      end;
    compound_literals= st.compound_literals |>)


val track_temporary_objects: forall 'a. elabM 'a -> elabM (list (wrapped_symbol * Ctype.ctype) * 'a)
let track_temporary_objects ma =
  fun conf st ->
    if st.temporary_objects <> [] then
      error "[Translation.E.track_temporary_objects]"
    else
      let (a, st') = ma conf st in
      ((st'.temporary_objects, a), <| st' with temporary_objects= [] |>)

val register_temporary_object: wrapped_symbol -> Ctype.ctype -> elabM unit
let register_temporary_object ptr_wrp ty =
  fun _ st -> ((), <| st with temporary_objects= (ptr_wrp, ty) :: st.temporary_objects |>)

(* returns the list of all the C objects in scope. *)
val get_visible_objects: elabM (list Symbol.sym)
let get_visible_objects = fun _ st ->
  (foldl (++) [] st.visible_objects, st)

val register_string_literal: Loc.t -> Symbol.sym -> Ctype.ctype -> C.pexpr -> elabM unit
let register_string_literal loc sym ty pe = fun _ st ->
  ((), <| st with string_literals= (loc, sym, ty, pe) :: st.string_literals |>)

val get_string_literals: elabM (list (Loc.t * Symbol.sym * Ctype.ctype * C.pexpr))
let get_string_literals = fun _ st ->
  (st.string_literals, st)

val register_compound_literal: Loc.t -> Symbol.prefix -> Symbol.sym -> bool -> Ctype.ctype -> elabM unit
let register_compound_literal loc prefix sym is_const ty = fun _ st ->
  ((), <| st with compound_literals= (loc, prefix, sym, is_const, ty) :: st.compound_literals |>)

val resolve_object_type: Symbol.sym -> elabM (Ctype.qualifiers * Ctype.ctype)
let resolve_object_type sym = fun _ st ->
  match Map.lookup sym st.visible_objects_types with
  | Just qs_ty ->
      (qs_ty, st)
  | Nothing ->
      (* let sym_str = match sym with
        *   | Symbol.Symbol _ n SD_None ->
        *       "sym_" ^ show n
        *   | Symbol.Symbol _ n (SD_Id str) ->
        *       str ^ "{" ^ show n ^ "}"
        * end in *)
      error ("Translation_effect.resolve_object_type ===> " ^ show sym)
  end



(* similar to Cabs_to_ail_effect.record_marker *)
val record_object_types_marker: unit -> elabM nat
let record_object_types_marker () =
  fresh_elab_int >>= fun marker_id ->
  begin
    if Global.backend_name () = "Cn" then
      get_visible_objects >>= fun visible_objects ->
      mapM (fun sym ->
        resolve_object_type sym >>= fun (_, ty) ->
        return (sym, ty)
      ) visible_objects >>= fun visible_objects_typed ->
      elab_update (fun st ->
        <| st with
          visible_objects_types_markers_env =
            Map.insert marker_id visible_objects_typed st.visible_objects_types_markers_env
        |>
        )
    else
      return ()
  end >>= fun () ->
  return marker_id


(* record that an (unrecoverable) error occurred, but don't abandon
   translation yet, so the user gets a full list of such errors *)
val record_error: string -> elabM unit
let record_error err =
    let () = Debug.print_unsupported err in
    elab_update (fun st -> <| st with errors = err :: st.errors |>)

val record_error_at: Loc.t -> string -> elabM unit
let record_error_at loc err = record_error
    ((Loc.stringFromLocation (Loc.with_cursor loc)) ^ ": " ^ err)


(*

val runStateM: forall 'a 'st. stateM 'a 'st -> 'st -> ('a * 'st)
let runStateM m st =
  m st


*)

val runElabM: forall 'a. elab_config -> elabM 'a -> elab_state -> ('a * elab_state)
let runElabM conf m st =
  m conf st

val runElabM_errors:
  forall 'a. elab_config -> elabM 'a -> elab_state -> 'a * elab_state
let runElabM_errors conf m st =
  let (rv, st) = m conf st in
  match List.reverse st.errors with
    | [] -> (rv, st)
    | (err1 :: _) -> error err1
  end

