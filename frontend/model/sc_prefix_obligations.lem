(* Pending prefix evidence, not an SC verdict or an operational fault.
   Recording a pair neither supplies the missing C location/action mapping nor
   completes G07 coverage. Absence of evidence never certifies a prefix.
   Keep the graph at discovery so later execution cannot erase the obligation. *)
open import Pervasives
import Sc_access_sequencing Sc_runtime Sc_graph Cmm_csem

type sc_prefix_obligation =
  | SC_obligation_access_sequencing of Sc_graph.sc_source_graph * list Sc_access_sequencing.sc_access_sequence_witness

let sc_sequence_witness_key pair =
  (pair.Sc_access_sequencing.sc_sequence_left.Sc_runtime.sc_effect_id,
   pair.Sc_access_sequencing.sc_sequence_right.Sc_runtime.sc_effect_id)

let sc_obligation_sequence_witnesses obligation = match obligation with
  | SC_obligation_access_sequencing _ witnesses -> witnesses
end

let sc_obligation_sequence_keys obligations = Set.fromList
  (List.concat (List.map (fun obligation -> List.map sc_sequence_witness_key
    (sc_obligation_sequence_witnesses obligation)) obligations))

let sc_accumulate_sequence_obligations state previous =
  let history = List.reverse state.Sc_runtime.sc_effects in
  if not (List.any (fun observed ->
      Sc_access_sequencing.sc_observed_access_order observed = Just Cmm_csem.Seq_cst) history)
    then previous
  else
    let graph = Sc_graph.sc_prefix_graph state in
    let witnesses = Sc_access_sequencing.sc_access_sequence_witnesses_reusing_graph graph history in
    let keys = sc_obligation_sequence_keys previous in
    (* Occurrence IDs identify witnesses only in a well-formed source graph.
       A malformed graph is separately a protocol finding; do not use its
       possibly duplicated IDs to suppress newly observed evidence. *)
    let fresh = if List.null graph.Sc_graph.sc_graph_issues then
      List.filter (fun pair -> not (sc_sequence_witness_key pair IN keys)) witnesses
      else witnesses in
    if List.null fresh then previous else
      SC_obligation_access_sequencing graph fresh :: previous
