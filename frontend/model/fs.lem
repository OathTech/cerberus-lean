declare lean target_rep function fs_closedir = `CerbFS.fs_closedir`

(* A fault is not errno. The state is the last defined filesystem state,
   which may be before a failed transition or after a failed return decoder.
   The Driver keeps this receipt separately from its committed fs_state. *)
type fs_fault
declare ocaml target_rep type fs_fault = `Fs_checked.fault`
declare lean target_rep type fs_fault = `CerbFS.FsFault`

val fs_fault_message: fs_fault -> string
declare ocaml target_rep function fs_fault_message = `Fs_checked.fault_text`
declare lean target_rep function fs_fault_message = `CerbFS.FsFault.text`

type fs_checked_result 'a = fs_state * either fs_fault (either fs_error 'a)

val fs_mkdir_checked: fs_state -> string -> integer -> fs_checked_result nat
declare ocaml target_rep function fs_mkdir_checked = `Fs_checked.run_mkdir`
declare lean target_rep function fs_mkdir_checked = `CerbFS.fs_mkdir_result`

val fs_open_checked: fs_state -> string -> integer -> maybe integer -> fs_checked_result nat
declare ocaml target_rep function fs_open_checked = `Fs_checked.run_open`
