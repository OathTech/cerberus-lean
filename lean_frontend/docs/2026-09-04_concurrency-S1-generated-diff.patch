+def model_refusal.ctor_rank_ocaml : model_refusal → Nat
+  | .MR_spawn_under_sequential => 0
+  | .MR_non_sc_order _ => 3
+  | .MR_fence _ => 4
+  | .MR_linux_action => 1
+  | .MR_wait => 2
