+  | .MR_non_sc_order x1, .MR_non_sc_order y1 => x1 == y1
+  | .MR_fence x1, .MR_fence y1 => x1 == y1
+  | .MR_linux_action, .MR_linux_action => true
+  | .MR_wait, .MR_wait => true
+  | _, _ => false
+termination_by structural cmpx_
+def model_refusal.compare_derived (cmpx_ cmpy_ : model_refusal) : Ordering := match cmpx_, cmpy_ with
+  | .MR_non_sc_order x1, .MR_non_sc_order y1 => Ord.compare x1 y1
+  | .MR_fence x1, .MR_fence y1 => Ord.compare x1 y1
+  | xg, yg => Ord.compare (model_refusal.ctor_rank_ocaml xg) (model_refusal.ctor_rank_ocaml yg)
+termination_by structural cmpx_
+end
