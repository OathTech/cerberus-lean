def main : IO UInt32 := do
 let mut errors := 0
 for (name,x,y,expected) in cases do
  let a := Value.ofBits x
  let b := Value.ofBits y
  let actual := (match name with
    | "add" => a + b | "sub" => a - b | "mul" => a * b | _ => a / b).toBits
  if actual != expected then
   errors := errors + 1
   IO.println s!"{name} {x} {y}: expected {expected}, actual {actual}"
 IO.println s!"{cases.length} actual OCaml arithmetic rows; mismatches={errors}"
 return if errors == 0 then 0 else 1
