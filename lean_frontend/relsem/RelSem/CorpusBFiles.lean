set_option autoImplicit false

namespace RelSem.Corpus

open RelSem.Slate (intParam funinfoOf)

/-! ## Expression-builder helpers (glob spines + spliced values) -/

/-- The parser's annotation stamp (CoreParser contract). -/
def aU : List annot := [Aloc CerbLocation.Loc.unknown]

def peval (v : value) : pexpr := Pexpr aU () (PEval v)

def intArrayTy (len : Int) : ctype :=
  Ctype [] (Array0 signed_int (some len))

def ucharTy : ctype := Ctype [] (Basic (Integer (Unsigned Ichar)))

def ucharArrayTy (len : Int) : ctype :=
  Ctype [] (Array0 ucharTy (some len))

def ivOf (v : Int) : CerbMem.IntegerValue :=
  CerbMem.IntegerValue.IV CerbMem.Provenance.Prov_none v

def loadedInt (v : Int) : loaded_value := LVspecified (OVinteger (ivOf v))

/-- A fully-evaluated loaded int-array value (the splice form). -/
def intArrayVal (vs : List Int) : value :=
  Vloaded (LVspecified (OVarray (vs.map loadedInt)))

def intScalarVal (v : Int) : value :=
  Vloaded (LVspecified (OVinteger (ivOf v)))

/-- The glob spine's binder symbol (synthetic — a fixed number far
    outside the hash vocabulary of every emitted program symbol; in
    each file's prior vocabulary via the census). Each glob's
    expression is its own scope, so one symbol serves all. -/
def globPtrSym : sym := Symbol "" 4611686018427387905
  (SD_Id "corpusb_glob_ptr")

/-- The glob spine: `create cty; store(_lock) cty ptr <value>;
    pure ptr` — the oracle's elaborated shape with the initializer
    expression replaced by the spliced evaluated value (header
    note). -/
def globExpr (cty : ctype) (lock : Bool) (v : value) : expr Unit :=
  Expr aU (Esseq
    (Pattern aU (CaseBase (some globPtrSym, BTy_object OTy_pointer)))
    (Expr aU (Eaction (Paction Pos (Action CerbLocation.Loc.unknown ()
      (Create (Pexpr aU () (PEctor Civalignof [peval (Vctype cty)]))
        (peval (Vctype cty)) (PrefOther "Core"))))))
    (Expr aU (Esseq (Pattern [] (CaseBase (none, BTy_unit)))
      (Expr aU (Eaction (Paction Pos (Action CerbLocation.Loc.unknown ()
        (Store0 lock (peval (Vctype cty))
          (Pexpr aU () (PEsym globPtrSym)) (peval v) NA)))))
      (Expr aU (Epure (Pexpr aU () (PEsym globPtrSym)))))))

def globOf (cty : ctype) (lock : Bool) (v : value) :
    generic_globs Unit Unit :=
  GlobalDef (BTy_object OTy_pointer, cty) (globExpr cty lock v)

/-- The spliced globals, by kind. `choices`/`expected` are
    `store_lock` (const), the arenas plain `store` — the dumps'
    shapes. -/
def intArrayGlob (vs : List Int) : generic_globs Unit Unit :=
  globOf (intArrayTy vs.length) true (intArrayVal vs)
def intScalarGlob (v : Int) : generic_globs Unit Unit :=
  globOf signed_int true (intScalarVal v)
def ucharArrayGlob (vs : List Int) : generic_globs Unit Unit :=
  globOf (ucharArrayTy vs.length) true (intArrayVal vs)
def intZeroArena (n : Nat) : generic_globs Unit Unit :=
  globOf (intArrayTy n) false (intArrayVal (List.replicate n 0))
def ucharZeroArena (n : Nat) : generic_globs Unit Unit :=
  globOf (ucharArrayTy n) false (intArrayVal (List.replicate n 0))

