    fmapEmpty)

/-! ## P14 count_pairs: choices = |xs| :: xs · expected_cnt =
    #{(i,j) | i<j, xs[i]=xs[j]} -/

/-- P14's pure model: Σ over positions k of the number of later
    equal elements (= the pair count). -/
def countPairs : List Int → Int
  | [] => 0
  | v :: rest => (rest.countP (· == v) : Int) + countPairs rest

def p14FileOf (xs : List Int) : file core_run_annotation :=
  convert_file (corpusBFileU mainP14Sym
    (Lem_Map.fromList
      [(countPairsP14Sym, countPairsP14Decl), (mainP14Sym, mainP14Decl)])
    (Lem_Map.fromList
      [(countPairsP14Sym, funinfoOf [ptrConstInt, intParam]),
       (mainP14Sym, funinfoOf [])])
    [(choicesSym, intArrayGlob ((xs.length : Int) :: xs)),
     (expectedCntSym, intScalarGlob (countPairs xs)),
     (bufSym, intZeroArena 65536)]
    fmapEmpty)

/-! ## P15 scan_classify: choices = s (uchar, NUL-terminated) ·
    expected_cnt = digit count before the first NUL -/

/-- P15's pure model: digit-class ('0'..'9' = 48..57) bytes strictly
    before the first NUL. -/
def digitCount : List Int → Int
  | [] => 0
  | b :: rest =>
    if b == 0 then 0
    else (if 48 ≤ b ∧ b ≤ 57 then 1 else 0) + digitCount rest

def p15FileOf (s : List Int) : file core_run_annotation :=
  convert_file (corpusBFileU mainP15Sym
    (Lem_Map.fromList
      [(scanClassifyP15Sym, scanClassifyP15Decl),
       (mainP15Sym, mainP15Decl)])
    (Lem_Map.fromList
      [(scanClassifyP15Sym, funinfoOf [ptrConstUchar]),
       (mainP15Sym, funinfoOf [])])
    [(choicesSym, ucharArrayGlob s),
     (expectedCntSym, intScalarGlob (digitCount s)),
     (bufSym, ucharZeroArena 1048576)]
    fmapEmpty)

/-! ## P07 list_sum / P08 list_reverse: the struct-node arena
    (choices = |l| :: π ++ heads — the H2 quantified LINK-ORDER
    permutation is DATA inside choices[]: the prologue links
    arena[π(i)] → arena[π(i+1)] at runtime, so the file family is
    still an int-array splice; the arena glob is the zeroed
    struct-node array). -/

def arenaSym : sym := Symbol "" 4048589636152510125 (SD_Id "arena")
def headIdent : identifier := Identifier CerbLocation.Loc.unknown "head"
def tailIdent : identifier := Identifier CerbLocation.Loc.unknown "tail"
def nodeSym : sym := Symbol "" 1953286315496161752 (SD_Id "node")
def nodeTy : ctype := Ctype [] (Struct nodeSym)
def ptrNodeTy : ctype := Ctype [] (Pointer no_qualifiers nodeTy)
def nodeArrayTy (len : Int) : ctype := Ctype [] (Array0 nodeTy (some len))

/-- A zeroed `struct node` element (the dump's
    `Specified((struct node){.head= Specified(0),
    .tail= Specified(NULL(void))})`). -/
def nodeZeroLv : loaded_value :=
  LVspecified (OVstruct nodeSym
    [(headIdent, signed_int,
      CerbMem.MemValue.MVinteger (Signed Int_) (ivOf 0)),
     (tailIdent, ptrNodeTy,
      CerbMem.MemValue.MVpointer (Ctype [] Void0)
        (CerbMem.PointerValue.PV CerbMem.Provenance.Prov_none
          (CerbMem.PointerValueBase.PVnull (Ctype [] Void0))))])

def nodeZeroArena (n : Nat) : generic_globs Unit Unit :=
  globOf (nodeArrayTy n) false
    (Vloaded (LVspecified (OVarray (List.replicate n nodeZeroLv))))

/-- `const struct node*` (P07's list_sum parameter). -/
def ptrConstNode : Option sym × ctype :=
  ((none : Option sym), Ctype [] (Pointer constQ nodeTy))
/-- `struct node*` (P08's list_reverse parameter/return). -/
def ptrNodeParam : Option sym × ctype := ((none : Option sym), ptrNodeTy)

def p07FileOf (heads : List Int) (pi_ : List Nat) :
    file core_run_annotation :=
  convert_file (corpusBFileU mainP07Sym
    (Lem_Map.fromList
      [(listSumP07Sym, listSumP07Decl), (mainP07Sym, mainP07Decl)])
    (Lem_Map.fromList
      [(listSumP07Sym, funinfoOf [ptrConstNode]),
       (mainP07Sym, funinfoOf [])])
    [(choicesSym, intArrayGlob
       ((heads.length : Int) :: (pi_.map (Int.ofNat) ++ heads))),
     (expectedSumSym, intScalarGlob (heads.foldl (· + ·) 0)),
     (arenaSym, nodeZeroArena 1048576)]
    (Lem_Map.fromList [(structNodeP07Sym, structNodeP07Def)]))

def p08FileOf (heads : List Int) (pi_ : List Nat) :
    file core_run_annotation :=
  convert_file (corpusBFileU mainP08Sym
    (Lem_Map.fromList
      [(listReverseP08Sym, listReverseP08Decl), (mainP08Sym, mainP08Decl)])
    (Lem_Map.fromList
      [(listReverseP08Sym,
        funinfoRet ptrNodeTy [ptrNodeParam]),
       (mainP08Sym, funinfoOf [])])
    [(choicesSym, intArrayGlob
       ((heads.length : Int) :: (pi_.map (Int.ofNat) ++ heads))),
     (expectedSym, intArrayGlob heads.reverse),
     (arenaSym, nodeZeroArena 1048576)]
    (Lem_Map.fromList [(structNodeP08Sym, structNodeP08Def)]))

