    bodies reference these; numbers transcribed from the emitted
    terms, census-validated) -/

def choicesSym : sym := Symbol "" 17671979768532607176 (SD_Id "choices")
def bufSym : sym := Symbol "" 13797158947008104142 (SD_Id "buf")
def expectedSym : sym := Symbol "" 16575640810736528685 (SD_Id "expected")
def expectedSumSym : sym :=
  Symbol "" 3809171288876350889 (SD_Id "expected_sum")
def expectedIdxSym : sym :=
  Symbol "" 7271390111886072348 (SD_Id "expected_idx")
def expectedCntSym : sym :=
  Symbol "" 13554910370011181821 (SD_Id "expected_cnt")
def targetSym : sym := Symbol "" 12828786762143176847 (SD_Id "target")

/-! ## funinfo vocabulary (per the dumps' ccall annotations) -/

/-- `const signed int*` (pointee const-qualified). -/
def ptrConstInt : Option sym × ctype :=
  ((none : Option sym), Ctype [] (Pointer constQ signed_int))
/-- `const unsigned char*`. -/
def ptrConstUchar : Option sym × ctype :=
  ((none : Option sym), Ctype [] (Pointer constQ ucharTy))

/-- The shared batch-B file skeleton: corpus stdlib, `main := some`,
    parametric globs. -/
def corpusBFileU (mainS : sym)
    (funs : Fmap sym (generic_fun_map_decl Unit Unit))
    (funinfo : Fmap sym (CerbLocation.Loc × attributes × ctype ×
      List (Option sym × ctype) × Bool × Bool))
    (globs : List (sym × generic_globs Unit Unit))
    (tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) :
    file Unit :=
  { corpusFileU funs funinfo tagDefs with
    main := some mainS, globs := globs }

/-! ## P04 arr_sum: choices = |xs| :: xs · expected_sum = Σ xs ·
    buf = int[2^20] zeroed -/

def p04FileOf (xs : List Int) : file core_run_annotation :=
  convert_file (corpusBFileU mainP04Sym
    (Lem_Map.fromList
      [(arrSumP04Sym, arrSumP04Decl), (mainP04Sym, mainP04Decl)])
    (Lem_Map.fromList
      [(arrSumP04Sym, funinfoOf [ptrConstInt, intParam]),
       (mainP04Sym, funinfoOf [])])
    [(choicesSym, intArrayGlob ((xs.length : Int) :: xs)),
     (expectedSumSym, intScalarGlob (xs.foldl (· + ·) 0)),
     (bufSym, intZeroArena 1048576)]
    fmapEmpty)

/-! ## P05 find_first: choices = |xs| :: xs · target = x ·
    expected_idx = the LEAST hit index else |xs| -/

/-- P05's pure model: the least index with `xs[i] = x`, else `|xs|`
    (`List.findIdx` returns the length on no hit — exactly the C
    function's contract). -/
def findFirstIdx (xs : List Int) (x : Int) : Int :=
  (xs.findIdx (· == x) : Int)

def p05FileOf (xs : List Int) (x : Int) : file core_run_annotation :=
  convert_file (corpusBFileU mainP05Sym
    (Lem_Map.fromList
      [(findFirstP05Sym, findFirstP05Decl), (mainP05Sym, mainP05Decl)])
    (Lem_Map.fromList
      [(findFirstP05Sym, funinfoOf [ptrConstInt, intParam, intParam]),
       (mainP05Sym, funinfoOf [])])
    [(choicesSym, intArrayGlob ((xs.length : Int) :: xs)),
     (targetSym, intScalarGlob x),
     (expectedIdxSym, intScalarGlob (findFirstIdx xs x)),
     (bufSym, intZeroArena 1048576)]
    fmapEmpty)

/-! ## P06 arr_reverse: choices = |xs| :: xs · expected = reverse xs -/

def p06FileOf (xs : List Int) : file core_run_annotation :=
