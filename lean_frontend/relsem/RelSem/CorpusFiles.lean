/-
  RelSem.CorpusFiles — V0 (2026-08-27): THE BATCH-A CORPUS PROGRAM
  TERMS (the FROZEN target corpus's scalar call-boundary rows —
  docs/2026-08-27_target-corpus.md; the V0 statement slate's fixture
  data, record docs/2026-08-27_v0-statements-and-ban.md).

  Assembles the kernel-transparent Core files the P01/P02/P03/P09/
  P10/P11/P12 statements quantify over, from the emitted parsed ASTs
  (RelSem/CorpusCore.lean — generated, drift-gated) plus pinned
  metadata, exactly as RelSem/T1File.lean / RelSem/SlateFiles.lean:

  * `funs`    := designated function + its callees (verbatim from the
                 pinned oracle dumps tests/corpus/*.core);
  * `stdlib`  := the T1 conv_loaded_int closure + the ccall-protocol
                 params trio (params_length/_aux/_nth — the internal
                 harness→callee ccalls read them; x3Stdlib lineage);
  * `funinfo` := hand-pinned C signatures (designated fn + callees —
                 the internal ccall's `cfunction`/are_compatible
                 checks read the CALLEE's entry; transcribed from the
                 dumps' ccall type annotations, validated behaviorally
                 by the corpus sample rows);
  * `tagDefs` := empty except P12 (`struct pt`, verbatim from the
                 pinned dump);
  * everything else empty/none (single-TU).

  House rules: no sorry, no axioms. Under the in-build audit.
-/

import Core_run_aux
import CerbFS
import RelSem.T1File
import RelSem.SlateFiles
import RelSem.CorpusCore

set_option autoImplicit false

namespace RelSem.Corpus

open RelSem.Slate (intParam funinfoOf slateFileU)

/-- The corpus stdlib: the T1 closure + the ccall-protocol params trio
    (the internal harness→callee calls evaluate params_length/
    params_nth). -/
def corpusStdlib : Fmap sym (generic_fun_map_decl Unit Unit) :=
  Lem_Map.fromList
    [(RelSem.T1.convLoadedIntSym, RelSem.T1.convLoadedIntDecl),
     (RelSem.T1.convIntSym, RelSem.T1.convIntDecl),
     (RelSem.T1.isReprIntegerSym, RelSem.T1.isReprIntegerDecl),
     (RelSem.T1.catchExceptionalSym, RelSem.T1.catchExceptionalDecl),
     (paramsLengthSym, paramsLengthDecl),
     (paramsLengthAuxSym, paramsLengthAuxDecl),
     (paramsNthSym, paramsNthDecl)]

/-- The corpus file skeleton (slateFileU with the corpus stdlib). -/
def corpusFileU (funs : Fmap sym (generic_fun_map_decl Unit Unit))
    (funinfo : Fmap sym (CerbLocation.Loc × attributes × ctype ×
      List (Option sym × ctype) × Bool × Bool))
    (tagDefs : Fmap sym (CerbLocation.Loc × tag_definition)) :
    file Unit :=
  { slateFileU funs funinfo tagDefs with stdlib := corpusStdlib }

/-- The shared harness filesystem. -/
def corpusFs : CerbFS.FsState := CerbFS.fs_initial_state

/-- funinfo payload with an explicit return type (the slate
    `funinfoOf` generalized — the corpus callees return `void`). -/
def funinfoRet (ret : ctype) (params : List (Option sym × ctype)) :
    CerbLocation.Loc × attributes × ctype × List (Option sym × ctype) ×
      Bool × Bool :=
  (CerbLocation.Loc.unknown, Attrs [], ret, params, false, true)

/-- `void` / `signed int*` / struct-pt pointer C types (funinfo
    vocabulary; qualifiers per the dumps' ccall annotations). -/
def voidTy : ctype := Ctype [] Void0
def ptrInt : Option sym × ctype :=
  ((none : Option sym), Ctype [] (Pointer no_qualifiers signed_int))
def structPtTy : ctype := Ctype [] (Struct structPtSym)
def constQ : qualifiers :=
  { const := true, restrict := false, volatile := false }
def ptrConstPt : Option sym × ctype :=
  ((none : Option sym), Ctype [] (Pointer constQ structPtTy))
def ptrPt : Option sym × ctype :=
  ((none : Option sym), Ctype [] (Pointer no_qualifiers structPtTy))

/-! ## P01 clamp -/

def p01FileU : file Unit :=
  corpusFileU (Lem_Map.fromList [(clampP01Sym, clampP01Decl)])
    (Lem_Map.fromList [(clampP01Sym, funinfoOf [intParam])])
    fmapEmpty

def p01File : file core_run_annotation := convert_file p01FileU

/-! ## P02 sat_add -/

def p02FileU : file Unit :=
  corpusFileU (Lem_Map.fromList [(satAddP02Sym, satAddP02Decl)])
    (Lem_Map.fromList [(satAddP02Sym, funinfoOf [intParam, intParam])])
    fmapEmpty

def p02File : file core_run_annotation := convert_file p02FileU

/-! ## P03 swap (both alias arms; designated fn = `harness`) -/

def p03FileU : file Unit :=
  corpusFileU
    (Lem_Map.fromList
      [(swapP03Sym, swapP03Decl), (harnessP03Sym, harnessP03Decl)])
    (Lem_Map.fromList
      [(harnessP03Sym, funinfoOf [intParam, intParam, intParam]),
       (swapP03Sym, funinfoRet voidTy [ptrInt, ptrInt])])
    fmapEmpty

def p03File : file core_run_annotation := convert_file p03FileU

/-! ## P09 call_contract (designated fn = `harness`) -/

def p09FileU : file Unit :=
  corpusFileU
    (Lem_Map.fromList
      [(bumpP09Sym, bumpP09Decl), (harnessP09Sym, harnessP09Decl)])
    (Lem_Map.fromList
      [(harnessP09Sym, funinfoOf [intParam, intParam]),
       (bumpP09Sym, funinfoRet voidTy [ptrInt])])
    fmapEmpty

def p09File : file core_run_annotation := convert_file p09FileU

/-! ## P10 gcd_rec -/

def p10FileU : file Unit :=
  corpusFileU (Lem_Map.fromList [(gcdRecP10Sym, gcdRecP10Decl)])
    (Lem_Map.fromList [(gcdRecP10Sym, funinfoOf [intParam, intParam])])
    fmapEmpty

def p10File : file core_run_annotation := convert_file p10FileU

/-! ## P11 gcd_iter -/

def p11FileU : file Unit :=
  corpusFileU (Lem_Map.fromList [(gcdIterP11Sym, gcdIterP11Decl)])
    (Lem_Map.fromList [(gcdIterP11Sym, funinfoOf [intParam, intParam])])
    fmapEmpty

def p11File : file core_run_annotation := convert_file p11FileU

/-! ## P12 pt_midpoint (designated fn = `harness`; struct pt) -/

def p12FileU : file Unit :=
  corpusFileU
    (Lem_Map.fromList
      [(midpointP12Sym, midpointP12Decl),
       (harnessP12Sym, harnessP12Decl)])
    (Lem_Map.fromList
      [(harnessP12Sym,
        funinfoOf [intParam, intParam, intParam, intParam]),
       (midpointP12Sym,
        funinfoRet voidTy [ptrConstPt, ptrConstPt, ptrPt])])
    (Lem_Map.fromList [(structPtSym, structPtDef)])

def p12File : file core_run_annotation := convert_file p12FileU

