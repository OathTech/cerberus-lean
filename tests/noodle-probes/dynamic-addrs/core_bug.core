-- dynamic-addrs Core-level probe: create an automatic object x (16-aligned),
-- alloc a ZERO-size dynamic region (align 8 = the model's IvMaxAlignment)
-- with NO intervening allocation, then free(x) (dynamic kill of the
-- automatic object). C11 7.22.3.3p2: UB. Cerberus should report UB179a.
proc main (): eff loaded integer :=
  let strong x_ptr: pointer = create(16, 'signed int') in
  store('signed int', x_ptr, Specified(1)) ;
  let strong q: pointer = alloc(8, 0) in
  free(x_ptr) ;
  pure(Specified(0))
