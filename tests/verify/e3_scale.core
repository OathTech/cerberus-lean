proc scale (x: pointer): eff loaded integer :=
  let strong y: pointer = create(Ivalignof('signed int'), 'signed int') in
  let strong a_525: loaded integer =
    bound(
      let weak (a_526: loaded integer, a_527: loaded integer) =
        unseq(
          let weak (a_532: loaded integer, a_533: loaded integer) =
            unseq(
              let weak a_531: pointer = pure(x) in
              load('signed int', a_531)
            ,
              pure(Specified(2))
            ) in
          pure(
            case (a_532, a_533) of
              | (Specified(a_534: integer), Specified(a_535: integer)) =>
                  Specified(catch_exceptional_condition_mul('signed int', conv_int('signed int',
                  a_534), conv_int('signed int', a_535)))
              | _: (loaded integer,loaded integer) =>
                  undef(<<UB036_exceptional_condition>>)
            end
          )
        ,
          pure(Specified(3))
        ) in
      pure(
        case (a_526, a_527) of
          | (Specified(a_528: integer), Specified(a_529: integer)) =>
              Specified(catch_exceptional_condition_add('signed int', __conv_int__('signed int', a_528), __conv_int__('signed int', a_529)))
          | _: (loaded integer,loaded integer) =>
              undef(<<UB036_exceptional_condition>>)
        end
      )
    ) in
  store('signed int', y, conv_loaded_int('signed int', a_525)) ;
  let strong a_538: loaded integer =
    bound(
      let weak a_537: pointer = pure(y) in
      load('signed int', a_537)
    ) in
  kill('signed int', y) ;
  run ret_524(conv_loaded_int('signed int', a_538)) ;
  kill('signed int', y) ;
  pure(Unit) ;
  save ret_524: loaded integer (a_539: loaded integer:= undef(<<UB088_reached_end_of_function>>)) in
    pure(a_539)

proc main (): eff loaded integer :=
  let strong a_521: loaded integer =
    bound(
      let strong ((a_511: loaded pointer,
      (a_512: ctype, a_513: [ctype], a_514: boolean, a_515: boolean)),
      a_517: loaded integer) =
        unseq(
          let strong a_510: loaded pointer =
            pure(Specified(Cfunction(scale))) in
          pure((a_510, cfunction(a_510)))
        ,
          pure(Specified(7))
        ) in
      if not(params_length(a_513) = 1) then
        pure(undef(<<UB038_number_of_args>>))
      else
        if a_514 \/ not(are_compatible ('signed int', a_512)) then
          pure(undef(<<UB041_function_not_compatible>>))
        else
          let strong a_516: pointer =
            let a_518: ctype = params_nth(a_513, 0) in
            if not(are_compatible ('signed int', a_518)) then
              pure(undef(<<UB041_function_not_compatible>>))
            else
              let weak a_519: pointer =
                create(Ivalignof('signed int'), 'signed int') in
              let weak _: unit =
                store('signed int', a_519, conv_loaded_int('signed int', a_517)) in
              pure(a_519) in
          let strong a_520: loaded integer =
            ccall('signed int (*) (signed int)', a_511, a_516) in
          kill('signed int', a_516) ;
          pure(a_520)
    ) in
  run ret_509(conv_loaded_int('signed int', a_521)) ;
  pure(Unit) ;
  save ret_509: loaded integer (a_522: loaded integer:= Specified(0)) in
    pure(a_522)

