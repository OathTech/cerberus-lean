proc add (a: pointer, b: pointer): eff loaded integer :=
  let strong a_537: loaded integer =
    bound(
      let weak (a_530: loaded integer, a_531: loaded integer) =
        unseq(
          let weak a_535: pointer = pure(a) in
          load('signed int', a_535)
        ,
          let weak a_536: pointer = pure(b) in
          load('signed int', a_536)
        ) in
      pure(
        case (a_530, a_531) of
          | (Specified(a_532: integer), Specified(a_533: integer)) =>
              Specified(catch_exceptional_condition_add('signed int', __conv_int__('signed int', a_532), __conv_int__('signed int', a_533)))
          | _: (loaded integer,loaded integer) =>
              undef(<<UB036_exceptional_condition>>)
        end
      )
    ) in
  run ret_529(conv_loaded_int('signed int', a_537)) ;
  pure(Unit) ;
  save ret_529: loaded integer (a_538: loaded integer:= undef(<<UB088_reached_end_of_function>>)) in
    pure(a_538)

proc main (): eff loaded integer :=
