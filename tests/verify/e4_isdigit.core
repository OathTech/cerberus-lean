proc is_digit (c: pointer): eff loaded integer :=
  let strong a_525: loaded integer =
    bound(
      let weak (a_527: loaded integer, a_528: loaded integer) =
        unseq(
          let strong a_548: loaded integer =
            let weak (a_532: loaded integer, a_533: loaded integer) =
              unseq(
                let weak (a_537: loaded integer, a_538: loaded integer) =
                  unseq(
                    let weak (a_543: loaded integer, a_544: loaded integer) =
                      unseq(
                        let weak a_542: pointer = pure(c) in
                        load('signed int', a_542)
                      ,
                        pure(Specified(48))
                      ) in
                    case (a_543, a_544) of
                      | (Specified(a_545: integer), Specified(a_546: integer)) =>
                          pure(
                            if conv_int('signed int', a_545) >=
                            conv_int('signed int', a_546) then
                              Specified(1)
                            else
                              Specified(0)
                          )
                      | _: (loaded integer,loaded integer) =>
                          pure(Unspecified('signed int'))
                    end
                  ,
