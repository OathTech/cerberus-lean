proc main (): eff loaded integer :=
  let strong a_520: loaded integer =
    bound(
      let strong ((a_510: loaded pointer,
      (a_511: ctype, a_512: [ctype], a_513: boolean, a_514: boolean)),
      a_516: loaded integer) =
        unseq(
          let strong a_509: loaded pointer =
            pure(Specified(Cfunction(is_digit))) in
          pure((a_509, cfunction(a_509)))
        ,
          pure(Specified(53))
        ) in
      if not(params_length(a_512) = 1) then
        pure(undef(<<UB038_number_of_args>>))
      else
        if a_513 \/ not(are_compatible ('signed int', a_511)) then
          pure(undef(<<UB041_function_not_compatible>>))
        else
          let strong a_515: pointer =
            let a_517: ctype = params_nth(a_512, 0) in
            if not(are_compatible ('signed int', a_517)) then
              pure(undef(<<UB041_function_not_compatible>>))
            else
              let weak a_518: pointer =
                create(Ivalignof('signed int'), 'signed int') in
              let weak _: unit =
                store('signed int', a_518, conv_loaded_int('signed int', a_516)) in
              pure(a_518) in
          let strong a_519: loaded integer =
            ccall('signed int (*) (signed int)', a_510, a_515) in
          kill('signed int', a_515) ;
          pure(a_519)
    ) in
  run ret_508(conv_loaded_int('signed int', a_520)) ;
  pure(Unit) ;
  save ret_508: loaded integer (a_521: loaded integer:= Specified(0)) in
    pure(a_521)

