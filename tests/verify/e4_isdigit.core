                )
              ,
                pure(Specified(0))
              ) in
            pure(
              case (a_532, a_533) of
                | (Specified(a_534: integer), Specified(a_535: integer)) =>
                    if conv_int('signed int', a_534) =
                    conv_int('signed int', a_535) then
                      Specified(1)
                    else
                      Specified(0)
                | _: (loaded integer,loaded integer) =>
                    Unspecified('signed int')
              end
            ) in
          case a_548 of
            | Specified(a_549: integer) =>
                if a_549 = 0 then
                  let strong a_550: loaded integer = pure(Specified(0)) in
                  pure(conv_loaded_int('signed int', a_550))
                else
                  let strong a_562: loaded integer =
                    let weak (a_551: loaded integer, a_552: loaded integer) =
                      unseq(
                        let weak (a_557: loaded integer, a_558: loaded integer) =
                          unseq(
                            let weak a_556: pointer = pure(c) in
                            load('signed int', a_556)
                          ,
                            pure(Specified(57))
                          ) in
                        case (a_557, a_558) of
                          | (Specified(a_559: integer),
                          Specified(a_560: integer)) =>
                              pure(
                                if conv_int('signed int', a_559) <=
                                conv_int('signed int', a_560) then
                                  Specified(1)
                                else
                                  Specified(0)
                              )
                          | _: (loaded integer,loaded integer) =>
                              pure(Unspecified('signed int'))
                        end
                      ,
                        pure(Specified(0))
                      ) in
                    pure(
                      case (a_551, a_552) of
                        | (Specified(a_553: integer), Specified(a_554: integer)) =>
                            if not(conv_int('signed int', a_553) =
                            conv_int('signed int', a_554)) then
                              Specified(1)
                            else
                              Specified(0)
                        | _: (loaded integer,loaded integer) =>
                            Unspecified('signed int')
                      end
                    ) in
                  pure(conv_loaded_int('signed int', a_562))
            | Unspecified(_: ctype) =>
                pure(undef(<<UB_CERB004_unspecified__conditional>>))
          end
        ,
          pure(Specified(0))
        ) in
      pure(
        case (a_527, a_528) of
          | (Specified(a_529: integer), Specified(a_530: integer)) =>
              if conv_int('signed int', a_529) = conv_int('signed int', a_530) then
                Specified(1)
              else
                Specified(0)
          | _: (loaded integer,loaded integer) =>
              Unspecified('signed int')
        end
      )
    ) in
  let strong a_524: boolean =
    case a_525 of
      | Specified(a_526: integer) =>
          pure(if not(a_526 = 1) then True else False)
      | Unspecified(_: ctype) =>
          nd(pure(True), pure(False))
    end in
  if a_524 then
    let strong a_563: loaded integer = bound(pure(Specified(1))) in
    run ret_523(conv_loaded_int('signed int', a_563)) ;
    pure(Unit)
  else
    pure(Unit) ;
  let strong a_564: loaded integer = bound(pure(Specified(0))) in
  run ret_523(conv_loaded_int('signed int', a_564)) ;
  pure(Unit) ;
  save ret_523: loaded integer (a_565: loaded integer:= undef(<<UB088_reached_end_of_function>>)) in
