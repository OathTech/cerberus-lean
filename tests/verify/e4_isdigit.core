                  ) in
                pure(
                  case (a_537, a_538) of
                    | (Specified(a_539: integer), Specified(a_540: integer)) =>
                        if conv_int('signed int', a_539) =
                        conv_int('signed int', a_540) then
                          Specified(1)
                        else
                          Specified(0)
                    | _: (loaded integer,loaded integer) =>
                        Unspecified('signed int')
