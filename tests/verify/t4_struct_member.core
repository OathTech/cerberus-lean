-- Aggregates
def struct S :=
  a: 'signed int'
  b: 'signed int'

-- Fun map
proc memb (v: pointer): eff loaded integer :=
  let strong s: pointer = create(Ivalignof('struct S'), 'struct S') in
  store('struct S', s, Unspecified('struct S')) ;
  let strong _: loaded integer =
    bound(
      let weak (a_526: pointer, a_529: loaded integer) =
        unseq(
          let strong a_527: pointer = pure(s) in
          pure(member_shift(a_527, S, .a))
        ,
          let weak a_528: pointer = pure(v) in
          load('signed int', a_528)
        ) in
      let weak _: unit =
        neg(store('signed int', a_526, conv_loaded_int('signed int', a_529))) in
      pure(conv_loaded_int('signed int', a_529))
    ) in
  pure(Unit) ;
  let strong _: loaded integer =
    bound(
      let weak (a_530: pointer, a_532: loaded integer) =
        unseq(
          let strong a_531: pointer = pure(s) in
          pure(member_shift(a_531, S, .b))
        ,
          pure(Specified(7))
        ) in
      let weak _: unit =
        neg(store('signed int', a_530, conv_loaded_int('signed int', a_532))) in
      pure(conv_loaded_int('signed int', a_532))
    ) in
  pure(Unit) ;
  let strong a_535: loaded integer =
    bound(
      let weak a_534: pointer =
        let strong a_533: pointer = pure(s) in
        pure(member_shift(a_533, S, .a)) in
      load('signed int', a_534)
    ) in
  kill('struct S', s) ;
  run ret_525(conv_loaded_int('signed int', a_535)) ;
  kill('struct S', s) ;
  pure(Unit) ;
  save ret_525: loaded integer (a_536: loaded integer:= undef(<<UB088_reached_end_of_function>>)) in
    pure(a_536)

proc main (): eff loaded integer :=
  let strong a_522: loaded integer =
    bound(
      let strong ((a_512: loaded pointer,
      (a_513: ctype, a_514: [ctype], a_515: boolean, a_516: boolean)),
      a_518: loaded integer) =
        unseq(
          let strong a_511: loaded pointer = pure(Specified(Cfunction(memb))) in
          pure((a_511, cfunction(a_511)))
        ,
          pure(Specified(42))
        ) in
      if not(params_length(a_514) = 1) then
        pure(undef(<<UB038_number_of_args>>))
      else
        if a_515 \/ not(are_compatible ('signed int', a_513)) then
          pure(undef(<<UB041_function_not_compatible>>))
        else
          let strong a_517: pointer =
            let a_519: ctype = params_nth(a_514, 0) in
            if not(are_compatible ('signed int', a_519)) then
              pure(undef(<<UB041_function_not_compatible>>))
            else
              let weak a_520: pointer =
                create(Ivalignof('signed int'), 'signed int') in
              let weak _: unit =
                store('signed int', a_520, conv_loaded_int('signed int', a_518)) in
              pure(a_520) in
          let strong a_521: loaded integer =
            ccall('signed int (*) (signed int)', a_512, a_517) in
          kill('signed int', a_517) ;
          pure(a_521)
    ) in
  run ret_510(conv_loaded_int('signed int', a_522)) ;
  pure(Unit) ;
  save ret_510: loaded integer (a_523: loaded integer:= Specified(0)) in
    pure(a_523)

